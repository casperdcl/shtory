#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# tui-shtory: vibe-coded interactive picker in pure bash (drop-in fallback if fzf isn't installed)
#
# Reads candidate lines from stdin (incrementally: the stream may still be
# arriving while the TUI is up, like fzf), shows them in a full-screen TUI
# on /dev/tty, prints the selected line to stdout.
# Keys: type to filter, up/down to move, left/right to scroll horizontally,
# enter to select, esc to cancel.
# Exit codes: 0 selected, 130 cancelled (as fzf), 1 error.
set -uo pipefail

# case-insensitive in-order word filter (empty $1 passes everything);
# a grep -E .*w1.*w2.* pattern: one C-speed process instead of a bash loop
tui_filter() {
  local words=$1 w c i esc pat='.*'
  (( $# > 1 )) || return 0
  if [[ -z $words ]]; then
    printf '%s\n' "${@:2}"
    return 0
  fi
  for w in $words; do  # shellcheck disable=SC2086 # word splitting intended
    esc=''
    for (( i = 0; i < ${#w}; i++ )); do
      c=${w:i:1}
      case $c in
        [a-zA-Z0-9_]) esc+=$c ;;
        *) esc+="\\$c" ;;
      esac
    done
    pat+="$esc.*"
  done
  printf '%s\n' "${@:2}" | grep -iE -e "$pat"
}

main() {
  local -a items=()
  if ! : > /dev/tty 2>/dev/null; then
    echo "tui-shtory: no tty" >&2
    exit 1
  fi

  local size cols lines
  if size=$(stty size < /dev/tty 2>/dev/null); then
    lines=${size% *}; cols=${size#* }
  else
    cols=$(tput cols 2>/dev/null) || cols=80
    lines=$(tput lines 2>/dev/null) || lines=24
  fi
  [[ $lines =~ ^[0-9]+$ ]] || lines=24
  [[ $cols =~ ^[0-9]+$ ]] || cols=80
  if (( lines < 8 )); then lines=8; fi
  if (( cols < 22 )); then cols=22; fi
  # every row is padded to exactly cols - 1 characters (one column of slack
  # against a +/-1 winsize error): no wrap, no stale tails, and no \e[K,
  # which Termux mishandles on pending-wrap lines (termux-app#3549). Rows
  # end in \r\n: in raw mode a bare \n is a line-feed without CR.
  local m w h padstr
  m=$(( cols - 1 ))
  w=$(( m - 1 ))
  h=$(( lines - 2 ))
  padstr=$(printf '%*s' "$w" '')

  local key line filter='' sel=0 hx=0 rc=1 saved='' alt=0 maxl=0
  local -a shown=()
  local filter_prev=$'\x01' # sentinel: force the first computation
  # streamed stdin: rows may still be arriving while the TUI is up;
  # drain between frames, buffering partial lines
  local pending_stdin='' stdin_open=1 dirty=1 filtered_upto=0
  saved=$(stty -g < /dev/tty 2>/dev/null) || saved=''
  # shellcheck disable=SC2329,SC2317 # invoked via trap
  restore_tty() {
    (( alt )) && printf '\e[?1049l' > /dev/tty 2>/dev/null
    if [[ -n $saved ]]; then
      stty "$saved" < /dev/tty 2>/dev/null
    else
      stty -raw echo < /dev/tty 2>/dev/null
    fi
  }
  trap restore_tty EXIT
  trap 'exit 130' INT
  # alt screen + full termios save, like fzf: leaving the tty raw (stty
  # round-trip alone) desyncs readline's terminal state in some bash builds
  # and breaks backspace/arrows on the line inserted afterwards
  if ! stty raw -echo < /dev/tty > /dev/null 2>&1; then
    exit 1
  fi
  printf '\e[?1049h' > /dev/tty
  alt=1

  # append complete stdin lines to items; return 1 on EOF. read -t
  # times out (>128) with the partial content it got: hold it in
  # pending_stdin until the line completes.
  drain_stdin() {
    local rc2=0 chunk='' n=0
    while :; do
      IFS= read -r -t 0.01 chunk || rc2=$?
      if (( rc2 == 0 )); then
        items+=("$pending_stdin$chunk"); pending_stdin=''; dirty=1
        # at most 200 lines per call: reading until the pipe is empty would
        # starve the key read while the stream is open
        if (( ++n >= 200 )); then
          return 0
        fi
      elif (( rc2 < 128 )); then
        if [[ -n $pending_stdin ]]; then
          items+=("$pending_stdin"); pending_stdin=''; dirty=1
        fi
        return 1
      elif [[ -n $chunk ]]; then
        pending_stdin+=$chunk
      else
        return 0
      fi
    done
  }

  # update shown from items. With an active filter, filter only the new
  # items (re-running the O(rows) filter over the whole list was the
  # visible lag per keystroke); a filter change re-filters everything.
  recompute() {
    if [[ -z $filter ]]; then
      shown=("${items[@]}")
      filtered_upto=${#items[@]}
    else
      if [[ $filter != "$filter_prev" ]]; then
        shown=(); filtered_upto=0
      fi
      while IFS= read -r line; do
        shown+=("$line")
      done < <(tui_filter "$filter" "${items[@]:$filtered_upto}")
      filtered_upto=${#items[@]}
    fi
    if (( sel >= ${#shown[@]} )); then
      if (( ${#shown[@]} > 0 )); then
        sel=$(( ${#shown[@]} - 1 ))
      else
        sel=0
      fi
    fi
  }

  # one accumulated string, one write: per-row printf syscalls are what
  # made each frame take hundreds of ms through the pty line discipline
  render() {
    local n start d
    start=$(( sel > h - 1 ? sel - h + 1 : 0 ))
    maxl=0
    for n in "${!shown[@]}"; do
      d=${shown[n]//$'\t'/  }
      if (( ${#d} > maxl )); then
        maxl=${#d}
      fi
    done
    if (( hx > maxl - w )); then
      hx=$(( maxl > w ? maxl - w : 0 ))
    fi
    local frame='' seg pad p2 pad2 r c1 tail b n1
    frame+=$'\e[H\e[J'
    for n in "${!shown[@]}"; do
      if (( n < start || n >= start + h )); then
        continue
      fi
      # first field (command) plain, second column onwards dim
      r=${shown[n]}
      if [[ $r == *$'\t'* ]]; then
        c1=${r%%$'\t'*}
        tail=${r#*$'\t'}
        d=$c1"  "${tail//$'\t'/  }
        b=${#c1}
      else
        d=${r//$'\t'/  }
        b=''
      fi
      seg=${d:hx:w}
      pad=${padstr:0:$(( w - ${#seg} ))}
      if [[ -z $b ]] || (( hx + w <= b )); then
        if (( n == sel )); then
          frame+=$'\e[7m '"$seg$pad"$'\e[0m\r\n'
        else
          frame+=' '"$seg$pad"$'\r\n'
        fi
      elif (( hx >= b )); then
        if (( n == sel )); then
          frame+=' '$'\e[7;2m'"$seg$pad"$'\e[0m\r\n'
        else
          frame+=' '$'\e[2m'"$seg$pad"$'\e[0m\r\n'
        fi
      else
        n1=$(( b - hx ))
        p2=${d:hx+n1:w-n1}
        pad2=${padstr:0:$(( w - n1 - ${#p2} ))}
        if (( n == sel )); then
          frame+=$'\e[7m '"${d:hx:n1}"$'\e[7;2m'"$p2$pad2"$'\e[0m\r\n'
        else
          frame+=' '"${d:hx:n1}"$'\e[2m'"$p2$pad2"$'\e[0m\r\n'
        fi
      fi
    done
    # filter prompt pinned to the bottom of the viewport, like fzf
    local prow=$(( ${#shown[@]} < h ? ${#shown[@]} : h ))
    while (( prow < h )); do
      frame+=' '"$padstr"$'\r\n'
      prow=$(( prow + 1 ))
    done
    # no padding/newline after the prompt: the cursor must stay right
    # behind the typed filter (stale padding is cleared by the next
    # frame's \e[J)
    printf '%s' "$frame ${filter:0:m-1}" > /dev/tty
  }

  local changed=1
  while :; do
    if (( stdin_open )); then
      if ! drain_stdin; then
        stdin_open=0
        if (( ${#items[@]} == 0 )); then
          exit 1
        fi
      fi
    fi
    if [[ $filter != "$filter_prev" ]] || (( dirty )); then
      recompute
      filter_prev=$filter
      dirty=0
      changed=1
    fi
    if (( changed )); then
      render
      changed=0
    fi
    rc=0
    if (( stdin_open )); then
      # poll briefly so rows keep arriving while the stream is open
      read -rs -N 1 -t 0.02 key < /dev/tty || rc=$?
    else
      read -rs -N 1 key < /dev/tty || rc=$?
    fi
    if (( rc > 128 )); then
      continue
    fi
    if (( rc )); then
      rc=1; break
    fi
    # any handled key may change what must be shown (arrows move sel/hx)
    changed=1
    if [[ $key == $'\x1b' ]]; then
      # arrows arrive as 3-byte CSI sequences; read exactly one so a fast
      # next keystroke is not swallowed into this one
      local k2 k3
      if IFS= read -rs -N 1 -t 0.02 k2 < /dev/tty; then
        if [[ $k2 == '[' || $k2 == 'O' ]]; then
          IFS= read -rs -N 1 -t 0.02 k3 < /dev/tty && key+=$k2$k3
        else
          key=$'\x1b'
        fi
      fi
    fi
    case $key in
      $'\x1b[A' | $'\x1bOA')
        if (( sel > 0 )); then sel=$(( sel - 1 )); fi ;;
      $'\x1b[B' | $'\x1bOB')
        if (( sel < ${#shown[@]} - 1 )); then sel=$(( sel + 1 )); fi ;;
      $'\x1b[D' | $'\x1bOD')
        if (( hx > 0 )); then hx=$(( hx - 1 )); fi ;;
      $'\x1b[C' | $'\x1bOC')
        if (( hx < maxl - w )); then hx=$(( hx + 1 )); fi ;;
      $'\x7f' | $'\b') filter=${filter%?} ;;
      $'\x1b') rc=130; break ;;
      $'\n' | $'\r')
        if [[ -n ${shown[sel]-} ]]; then
          printf '%s\n' "${shown[sel]}"
          rc=0
        fi
        break ;;
      *) if [[ ${key:0:1} != [[:cntrl:]] ]]; then filter+=$key; fi ;;
    esac
  done
  exit $rc
}

# main guard: sourceable (tests use tui_filter) without running the picker
[[ ${BASH_SOURCE[0]} == "$0" ]] && main
