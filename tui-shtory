#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# tui-shtory: vibe-coded interactive picker in pure bash (drop-in fallback if fzf isn't installed)
#
# Reads candidate lines from stdin (incrementally: the stream may still be
# arriving while the TUI is up, like fzf), shows them in a full-screen TUI
# on /dev/tty, prints the selected line to stdout.
# Keys: type to filter, up/down to move, left/right to scroll horizontally,
# enter to select, esc to cancel.
# Exit codes: 0 selected, 130 cancelled (as fzf), 1 error.
set -uo pipefail

# build the case-insensitive in-order word filter regex from $1's words:
# a grep -E .*w1.*w2.* pattern (one C-speed process instead of a bash loop)
filter_pattern() {
  local words=$1 w c i esc pat='.*'
  for w in $words; do  # shellcheck disable=SC2086 # word splitting intended
    esc=''
    for (( i = 0; i < ${#w}; i++ )); do
      c=${w:i:1}
      case $c in
        [a-zA-Z0-9_]) esc+=$c ;;
        *) esc+="\\$c" ;;
      esac
    done
    pat+="$esc.*"
  done
  printf '%s' "$pat"
}

# case-insensitive in-order word filter (empty $1 passes everything);
# kept for tests - pipes items through grep at C speed
tui_filter() {
  local words=$1 pat
  (( $# > 1 )) || return 0
  if [[ -z $words ]]; then
    printf '%s\n' "${@:2}"
    return 0
  fi
  pat=$(filter_pattern "$words")
  printf '%s\n' "${@:2}" | grep -iE -e "$pat"
}

main() {
  local freeze=0
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --freeze-left=*) freeze=${1#*=} ;;
      *) echo "tui-shtory: unknown option '$1'" >&2; exit 1 ;;
    esac
    shift
  done
  [[ $freeze =~ ^[0-9]+$ ]] || { echo "tui-shtory: invalid --freeze-left" >&2; exit 1; }

  if ! : > /dev/tty 2>/dev/null; then
    echo "tui-shtory: no tty" >&2
    exit 1
  fi

  local size cols lines
  if size=$(stty size < /dev/tty 2>/dev/null); then
    lines=${size% *}; cols=${size#* }
  else
    cols=$(tput cols 2>/dev/null) || cols=80
    lines=$(tput lines 2>/dev/null) || lines=24
  fi
  [[ $lines =~ ^[0-9]+$ ]] || lines=24
  [[ $cols =~ ^[0-9]+$ ]] || cols=80
  if (( lines < 8 )); then lines=8; fi
  if (( cols < 22 )); then cols=22; fi
  # every row is padded to exactly cols - 1 characters (one column of slack
  # against a +/-1 winsize error): no wrap, no stale tails, and no \e[K,
  # which Termux mishandles on pending-wrap lines (termux-app#3549). Rows
  # end in \r\n: in raw mode a bare \n is a line-feed without CR.
  local m w h padstr dashstr
  m=$(( cols - 1 ))
  w=$(( m - 1 ))
  h=$(( lines - 2 ))
  padstr=$(printf '%*s' "$w" '')
  dashstr=$(printf '\u2500%.0s' $(seq 1 $(( w + 4 ))))

  local key filter='' sel=0 hx=0 rc=1 saved='' alt=0 maxl=0 nlist=0 nloaded=0
  local batch='' pending='' quit=0 i c
  local filter_prev=$'\x01' # sentinel: force the first computation
  # streamed stdin: rows may still be arriving while the TUI is up. A
  # background feeder reads them (fd 6) and appends them to a file
  # (itemsfile), publishing the cumulative line count after each batch. The
  # main loop polls the tty (never the stream: a blocking read on the stream
  # stalled key input for seconds - the original input starvation) and
  # notices new rows by watching the count.
  # The list is a file, not a bash array: a 100k-element array per keystroke
  # was the O(rows) search cost. A filter is a grep of the file (C-speed);
  # only the visible h-row window is materialised per frame (sed).
  local tmpd itemsfile matchesfile activefile countfile eof
  tmpd=$(mktemp -d) || exit 1
  itemsfile="$tmpd/items"; matchesfile="$tmpd/matches"; countfile="$tmpd/count"; eof="$tmpd/eof"
  : > "$itemsfile"; printf 0 > "$countfile"
  activefile=$itemsfile
  exec 6<&0
  local stdin_open=1 dirty=1 feeder_pid='' changed=1 last_count=0 cur=0
  saved=$(stty -g < /dev/tty 2>/dev/null) || saved=''
  # shellcheck disable=SC2329,SC2317 # invoked via trap
  restore_tty() {
    if (( alt )); then
      printf '\e[?1049l' > /dev/tty 2>/dev/null
      printf '\e[?25h' > /dev/tty 2>/dev/null
    fi
    if [[ -n $saved ]]; then
      stty "$saved" < /dev/tty 2>/dev/null
    else
      stty -raw echo < /dev/tty 2>/dev/null
    fi
    if [[ -n $feeder_pid ]]; then
      kill "$feeder_pid" 2>/dev/null
    fi
    rm -rf "$tmpd"
  }
  trap restore_tty EXIT
  trap 'exit 130' INT
  # alt screen + full termios save, like fzf: leaving the tty raw (stty
  # round-trip alone) desyncs readline's terminal state in some bash builds
  # and breaks backspace/arrows on the line inserted afterwards
  if ! stty raw -echo < /dev/tty > /dev/null 2>&1; then
    exit 1
  fi
  printf '\e[?1049h' > /dev/tty
  alt=1
  # clear once + hide the cursor (like fzf): the renderer then rewrites
  # only changed lines, so no per-frame erase/redraw
  printf '\e[2J\e[?25l' > /dev/tty

  # read the stream (fd 6) and append it to itemsfile in batches; publish
  # the cumulative line count after each batch (the main loop watches it).
  # Fully async: the main loop never reads the stream, so key input is never
  # starved. A batch is 1024 lines or 48KB.
  feeder() {
    local l batch='' n=0 total=0 final=0
    flush() {
      if [[ -n $batch ]]; then
        printf '%s' "$batch" >> "$itemsfile"
        total=$(( total + n ))
        printf '%s\n' "$total" > "$countfile"
      fi
      batch=''; n=0
      (( final )) && touch "$eof"
    }
    while IFS= read -r -u 6 l || [[ -n $l ]]; do
      batch+="$l"$'\n'; n=$(( n + 1 ))
      if (( n >= 1024 || ${#batch} >= 49152 )); then
        flush
      fi
    done
    final=1 # terminal flush (empty if the stream ran dry) = stream over
    flush
  }
  feeder &
  feeder_pid=$!

  # point activefile at the items file (no filter) or a fresh grep of it
  # (filter active); keep nlist = its line count fresh for the key handler
  # and render. The list is a file, not a bash array: a 100k-element array
  # per keystroke was the O(rows) search cost, whereas grep + a per-frame
  # h-row window extract is C-speed.
  recompute() {
    if [[ -z $filter ]]; then
      activefile=$itemsfile
      nlist=$nloaded
    else
      grep -iE -e "$(filter_pattern "$filter")" "$itemsfile" > "$matchesfile"
      activefile=$matchesfile
      nlist=$(wc -l < "$matchesfile"); nlist=${nlist//[!0-9]/}
    fi
    if (( sel >= nlist )); then
      if (( nlist > 0 )); then
        sel=$(( nlist - 1 ))
      else
        sel=0
      fi
    fi
  }

  # diff render (like fzf): each screen row is rewritten only when its
  # content changes, by absolute position - no \e[H\e[J. Erasing and
  # redrawing the whole screen per batch was the flicker while the list
  # filled; once the window stops changing, a render writes nothing.
  # Every row is exactly m chars (padding covers stale content, so no
  # \e[K), and the hidden cursor makes its position between writes moot.
  local -a prev=()
  for (( i = 0; i < h + 2; i++ )); do
    prev[i]=' '"$padstr"
  done
  render() {
    local start top i d
    # bottom-anchored window (fzf default layout): the newest visible row
    # sits just above the prompt, older rows above it, oldest scrolled up
    # off the top; scrolling keeps the cursor in the window, pinned to the
    # edge it crossed (fzf --scroll-off=0)
    start=$(( sel - h + 1 < 0 ? 0 : sel - h + 1 ))
    top=$(( nlist - h < 0 ? 0 : nlist - h ))
    (( start > top )) && start=$top
    # materialise only the visible h rows (sed + mapfile, C-speed); the
    # window is stable while rows stream in at the newest end, so a
    # streaming load neither flickers nor re-scans the whole file
    local -a window=()
    if (( nlist > 0 )); then
      mapfile -t window < <(sed -n "$(( start + 1 )),$(( start + h ))p" "$activefile")
    fi
    local wcount=${#window[@]} seli=$(( sel - start ))
    # max length over the visible window only (O(h), not O(rows)); the
    # horizontal scroll bound is therefore window-relative
    maxl=0
    for (( i = 0; i < wcount; i++ )); do
      d=${window[i]//$'\t'/  }
      if (( ${#d} > maxl )); then
        maxl=${#d}
      fi
    done
    if (( hx > maxl - w )); then
      hx=$(( maxl > w ? maxl - w : 0 ))
    fi
    local out='' row l r c1 tail b seg pad p2 pad2 n1 fz rest rw tmp f
    # screen row r (1-based) shows window[h-r]: the newest visible row at
    # the bottom (row h), oldest at the top (row 1); row h+1 = status, row
    # h+2 = the prompt
    for (( row = 1, i = h - 1; i >= 0; row++, i-- )); do
      if (( i >= wcount )); then
        l=' '"$padstr"
      elif (( freeze > 0 )); then
        # freeze-left: first `freeze` tab-delimited fields plain + left-aligned
        # (always visible); the rest is dim, right-aligned when it fits
        # (leaving a gap after the frozen part), else left-aligned and clipped
        # off the right
        r=${window[i]}
        fz=''; tmp=$r
        for (( f = 1; f <= freeze; f++ )); do
          if [[ $tmp == *$'\t'* ]]; then
            fz+="${tmp%%$'\t'*}"$'\t'
            tmp=${tmp#*$'\t'}
          else
            fz+=$tmp
            tmp=''
            break
          fi
        done
        # keep the boundary tab (separator) only when there is a rest
        if [[ -z $tmp ]]; then
          fz=${fz%$'\t'}
        fi
        rest=$tmp
        fz=${fz//$'\t'/  }
        rest=${rest//$'\t'/  }
        rw=$(( w - ${#fz} ))
        if (( ${#rest} <= rw )); then
          rest="${padstr:0:$(( rw - ${#rest} ))}$rest"
        else
          rest=${rest:0:rw}
        fi
        if (( i == seli )); then
          l=$'\e[7m '"$fz"$'\e[7;2m'"$rest"$'\e[0m'
        else
          l=' '"$fz"$'\e[2m'"$rest"$'\e[0m'
        fi
      else
        # first field (command) plain, second column onwards dim
        r=${window[i]}
        if [[ $r == *$'\t'* ]]; then
          c1=${r%%$'\t'*}
          tail=${r#*$'\t'}
          d=$c1"  "${tail//$'\t'/  }
          b=${#c1}
        else
          d=${r//$'\t'/  }
          b=''
        fi
        seg=${d:hx:w}
        pad=${padstr:0:$(( w - ${#seg} ))}
        if [[ -z $b ]] || (( hx + w <= b )); then
          if (( i == seli )); then
            l=$'\e[7m '"$seg$pad"$'\e[0m'
          else
            l=' '"$seg$pad"
          fi
        elif (( hx >= b )); then
          if (( i == seli )); then
            l=' '$'\e[7;2m'"$seg$pad"$'\e[0m'
          else
            l=' '$'\e[2m'"$seg$pad"$'\e[0m'
          fi
        else
          n1=$(( b - hx ))
          p2=${d:hx+n1:w-n1}
          pad2=${padstr:0:$(( w - n1 - ${#p2} ))}
          if (( i == seli )); then
            l=$'\e[7m '"${d:hx:n1}"$'\e[7;2m'"$p2$pad2"$'\e[0m'
          else
            l=' '"${d:hx:n1}"$'\e[2m'"$p2$pad2"$'\e[0m'
          fi
        fi
      fi
      if [[ $l != "${prev[row-1]}" ]]; then
        out+=$'\e['"$row"';1H'"$l"
        prev[row-1]=$l
      fi
    done
    # status row just above the prompt (like fzf): matches/loaded plus a
    # box-drawing line to the end of the screen; cursor is hidden, so pad
    # every row to m (a shorter rewrite would leave stale characters)
    l=" ${nlist}/${nloaded} "
    l+="${dashstr:0:$(( m - ${#l} ))}"
    if [[ $l != "${prev[h]}" ]]; then
      out+=$'\e['$(( h + 1 ))';1H'"${l:0:m}"
      prev[h]=$l
    fi
    # prompt row
    l="> ${filter:0:m-2}"
    l+="${padstr:0:$(( m - ${#l} ))}"
    if [[ $l != "${prev[h+1]}" ]]; then
      out+=$'\e['$(( h + 2 ))';1H'"${l:0:m}"
      prev[h+1]=$l
    fi
    [[ -n $out ]] && printf '%s' "$out" > /dev/tty
  }

  while :; do
    if (( stdin_open )); then
      # notice new rows: the feeder publishes the cumulative count after
      # each batch (O(1) read; the main loop never reads the stream)
      IFS= read -r cur < "$countfile" || cur=0
      cur=${cur:-0}
      if (( cur != last_count )); then
        nloaded=$cur
        last_count=$cur
        dirty=1
      fi
      if [[ -e $eof ]]; then
        stdin_open=0
        if (( nloaded == 0 )); then
          exit 1
        fi
      fi
    fi
    if [[ $filter != "$filter_prev" ]] || (( dirty )); then
      recompute
      filter_prev=$filter
      dirty=0
      changed=1
    fi
    if (( changed )); then
      render
      changed=0
    fi
    # poll the tty (never the stream: that was the input starvation). Read a
    # whole buffer of pending bytes in one go and reassemble CSI sequences
    # with a pending-ESC state machine (like fzf). A held arrow streams
    # ESC [ A ESC [ A ...; reading one byte then blocking for the rest split
    # that stream and leaked literal [A into the filter. A lone ESC at the
    # end of a buffer is held (pending) for the next read instead of
    # cancelling immediately, so a slow/ssh split still reassembles
    rc=0
    read -rs -N 64 -t 0.005 batch < /dev/tty || rc=$?
    if (( rc == 1 )); then   # EOF: the tty closed
      rc=1; break
    fi
    [[ -z $batch ]] && continue
    changed=1
    quit=0
    for (( i = 0; i < ${#batch}; i++ )); do
      (( quit )) && break
      c=${batch:i:1}
      key=''
      if [[ $pending == $'\x1b' ]]; then
        # waiting for a CSI prefix ([ or O) after a lone ESC
        if [[ $c == '[' || $c == 'O' ]]; then
          pending+=$c; continue
        fi
        rc=130; quit=1; pending=''; continue   # not a CSI: lone ESC -> cancel
      elif [[ -n $pending ]]; then
        # pending is ESC[ or ESCO, waiting for the final (A/B/C/D)
        if [[ $c == [ABCD] ]]; then
          key=$pending$c; pending=''
        else
          pending=''   # not a final: the prefix was stray; reprocess c fresh
        fi
      fi
      if [[ -z $key ]]; then
        # a fresh byte
        if [[ $c == $'\x1b' ]]; then
          pending=$'\x1b'; continue
        elif [[ $c == '[' || $c == 'O' ]]; then
          continue   # stray prefix (no preceding ESC)
        fi
        key=$c
      fi
      case $key in
        $'\x1b[A' | $'\x1bOA')
          # bottom-up list: up = older items (sel+1), down = newer (sel-1)
          if (( sel < nlist - 1 )); then sel=$(( sel + 1 )); fi ;;
        $'\x1b[B' | $'\x1bOB')
          if (( sel > 0 )); then sel=$(( sel - 1 )); fi ;;
        $'\x1b[D' | $'\x1bOD')
          if (( hx > 0 )); then hx=$(( hx - 1 )); fi ;;
        $'\x1b[C' | $'\x1bOC')
          if (( hx < maxl - w )); then hx=$(( hx + 1 )); fi ;;
        $'\x7f' | $'\b') filter=${filter%?} ;;
        $'\x1b') rc=130; quit=1 ;;
        $'\n' | $'\r')
          if (( sel < nlist )); then
            printf '%s\n' "$(sed -n "$(( sel + 1 ))p" "$activefile")"
            rc=0
          fi
          quit=1 ;;
        *) if [[ ${key:0:1} != [[:cntrl:]] ]]; then filter+=$key; fi ;;
      esac
      pending=''
      # a filter change must be recomputed before any later key in this same
      # batch (e.g. a buffered "a\n") selects, so the select sees the fresh
      # activefile/nlist (one key per iteration used to do this implicitly)
      if [[ $filter != "$filter_prev" ]]; then
        recompute
        filter_prev=$filter
        changed=1
      fi
    done
    (( quit )) && break
  done
  exit $rc
}

# main guard: sourceable (tests use tui_filter) without running the picker
[[ ${BASH_SOURCE[0]} == "$0" ]] && main "$@"
