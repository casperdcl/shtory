#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# tui-shtory: vibe-coded interactive picker in pure bash (drop-in fallback if fzf isn't installed)
#
# Reads candidate lines from stdin (incrementally: the stream may still be
# arriving while the TUI is up, like fzf), shows them in a full-screen TUI
# on /dev/tty, prints the selected line to stdout.
# Keys: type to filter, up/down to move, left/right to scroll horizontally,
# enter to select, esc to cancel.
# Exit codes: 0 selected, 130 cancelled (as fzf), 1 error.
set -uo pipefail

# case-insensitive in-order word filter (empty $1 passes everything);
# a grep -E .*w1.*w2.* pattern: one C-speed process instead of a bash loop
tui_filter() {
  local words=$1 w c i esc pat='.*'
  (( $# > 1 )) || return 0
  if [[ -z $words ]]; then
    printf '%s\n' "${@:2}"
    return 0
  fi
  for w in $words; do  # shellcheck disable=SC2086 # word splitting intended
    esc=''
    for (( i = 0; i < ${#w}; i++ )); do
      c=${w:i:1}
      case $c in
        [a-zA-Z0-9_]) esc+=$c ;;
        *) esc+="\\$c" ;;
      esac
    done
    pat+="$esc.*"
  done
  printf '%s\n' "${@:2}" | grep -iE -e "$pat"
}

main() {
  local -a items=()
  if ! : > /dev/tty 2>/dev/null; then
    echo "tui-shtory: no tty" >&2
    exit 1
  fi

  local size cols lines
  if size=$(stty size < /dev/tty 2>/dev/null); then
    lines=${size% *}; cols=${size#* }
  else
    cols=$(tput cols 2>/dev/null) || cols=80
    lines=$(tput lines 2>/dev/null) || lines=24
  fi
  [[ $lines =~ ^[0-9]+$ ]] || lines=24
  [[ $cols =~ ^[0-9]+$ ]] || cols=80
  if (( lines < 8 )); then lines=8; fi
  if (( cols < 22 )); then cols=22; fi
  # every row is padded to exactly cols - 1 characters (one column of slack
  # against a +/-1 winsize error): no wrap, no stale tails, and no \e[K,
  # which Termux mishandles on pending-wrap lines (termux-app#3549). Rows
  # end in \r\n: in raw mode a bare \n is a line-feed without CR.
  local m w h padstr
  m=$(( cols - 1 ))
  w=$(( m - 1 ))
  h=$(( lines - 2 ))
  padstr=$(printf '%*s' "$w" '')

  local key line filter='' sel=0 hx=0 rc=1 saved='' alt=0 maxl=0
  local -a shown=()
  local filter_prev=$'\x01' # sentinel: force the first computation
  # streamed stdin: rows may still be arriving while the TUI is up. A
  # background feeder reads them (buffered, C-speed) and sends
  # sentinel-delimited batches over a FIFO, one unacked batch at a time (a
  # batch must fit the pipe buffer while the main loop is busy); the main
  # loop polls the tty with a short timeout and drains pending batches each
  # pass. No signals: bash's read-with-trapped-USR1 restarts/delays
  # nondeterministically, and a blocking `read` on the stream itself drains
  # byte-by-byte and stalls key input for seconds. (Background jobs in a
  # non-interactive shell get stdin from /dev/null, so the stream is kept
  # on fd 6 for the feeder.)
  local tmpd fifo ackf mark eof sentinel
  tmpd=$(mktemp -d) || exit 1
  fifo="$tmpd/batch"; ackf="$tmpd/ack"; mark="$tmpd/mark"; eof="$tmpd/eof"
  if ! mkfifo "$fifo" || ! mkfifo "$ackf"; then
    rm -rf "$tmpd"
    exit 1
  fi
  : > "$mark"
  sentinel="shtory-batch-$$_$RANDOM"
  exec 3<> "$fifo" 4> "$fifo" 5<> "$ackf" 6<&0
  local stdin_open=1 dirty=1 filtered_upto=0 feeder_pid=''
  saved=$(stty -g < /dev/tty 2>/dev/null) || saved=''
  # shellcheck disable=SC2329,SC2317 # invoked via trap
  restore_tty() {
    if (( alt )); then
      printf '\e[?1049l' > /dev/tty 2>/dev/null
      printf '\e[?25h' > /dev/tty 2>/dev/null
    fi
    if [[ -n $saved ]]; then
      stty "$saved" < /dev/tty 2>/dev/null
    else
      stty -raw echo < /dev/tty 2>/dev/null
    fi
    if [[ -n $feeder_pid ]]; then
      kill "$feeder_pid" 2>/dev/null
    fi
    rm -rf "$tmpd"
  }
  trap restore_tty EXIT
  trap 'exit 130' INT
  # alt screen + full termios save, like fzf: leaving the tty raw (stty
  # round-trip alone) desyncs readline's terminal state in some bash builds
  # and breaks backspace/arrows on the line inserted afterwards
  if ! stty raw -echo < /dev/tty > /dev/null 2>&1; then
    exit 1
  fi
  printf '\e[?1049h' > /dev/tty
  alt=1
  # clear once + hide the cursor (like fzf): the renderer then rewrites
  # only changed lines, so no per-frame erase/redraw
  printf '\e[2J\e[?25l' > /dev/tty

  # read the stream (fd 6) and send batches; flush at 256 lines or 16KB
  # (a batch must fit the pipe buffer while the main loop is between
  # batches), then block on the main loop's ack before sending the next
  feeder() {
    local l batch='' n=0 final=0
    send() {
      printf '%s%s\n' "$batch" "$sentinel" >&4
      batch=''; n=0
      printf x >> "$mark"
      (( final )) && touch "$eof"
      read -rs -N 1 -u 5 # block on the main loop's ack (byte -> REPLY)
    }
    while IFS= read -r -u 6 l || [[ -n $l ]]; do
      batch+="$l"$'\n'; n=$(( n + 1 ))
      if (( n >= 256 || ${#batch} >= 16384 )); then
        send
      fi
    done
    final=1 # terminal batch (empty if the stream ran dry) = stream over
    send
  }

  # one batch is guaranteed to be in the FIFO (ack handshake); drop items
  # up to the sentinel
  drain_batch() {
    local l
    while IFS= read -r -u 3 l; do
      if [[ $l == "$sentinel" ]]; then
        return 0
      fi
      items+=("$l"); dirty=1
    done
    return 1
  }

  # update shown from items. With an active filter, filter only the new
  # items (re-running the O(rows) filter over the whole list was the
  # visible lag per keystroke); a filter change re-filters everything.
  recompute() {
    if [[ -z $filter ]]; then
      shown=("${items[@]}")
      filtered_upto=${#items[@]}
    else
      if [[ $filter != "$filter_prev" ]]; then
        shown=(); filtered_upto=0
      fi
      while IFS= read -r line; do
        shown+=("$line")
      done < <(tui_filter "$filter" "${items[@]:$filtered_upto}")
      filtered_upto=${#items[@]}
    fi
    if (( sel >= ${#shown[@]} )); then
      if (( ${#shown[@]} > 0 )); then
        sel=$(( ${#shown[@]} - 1 ))
      else
        sel=0
      fi
    fi
  }

  # diff render (like fzf): each screen row is rewritten only when its
  # content changes, by absolute position - no \e[H\e[J. Erasing and
  # redrawing the whole screen per batch was the flicker while the list
  # filled; once the window stops changing, a render writes nothing.
  # Every row is exactly m chars (padding covers stale content, so no
  # \e[K), and the hidden cursor makes its position between writes moot.
  local -a prev=()
  for (( i = 0; i < h + 1; i++ )); do
    prev[i]=' '"$padstr"
  done
  render() {
    local n start d top
    # bottom-anchored window (fzf default layout): the newest visible row
    # sits just above the prompt, older rows above it, oldest scrolled up
    # off the top; scrolling keeps the cursor in the window, pinned to the
    # edge it crossed (fzf --scroll-off=0)
    start=$(( sel - h + 1 < 0 ? 0 : sel - h + 1 ))
    top=$(( ${#shown[@]} - h < 0 ? 0 : ${#shown[@]} - h ))
    (( start > top )) && start=$top
    maxl=0
    for n in "${!shown[@]}"; do
      d=${shown[n]//$'\t'/  }
      if (( ${#d} > maxl )); then
        maxl=${#d}
      fi
    done
    if (( hx > maxl - w )); then
      hx=$(( maxl > w ? maxl - w : 0 ))
    fi
    local out='' row l r c1 tail b seg pad p2 pad2 n1
    # screen row r (1-based) = item start + h - r; row h+1 = the prompt
    for (( row = 1, n = start + h - 1; n >= start; row++, n-- )); do
      if (( n >= ${#shown[@]} )); then
        l=' '"$padstr"
      else
        # first field (command) plain, second column onwards dim
        r=${shown[n]}
        if [[ $r == *$'\t'* ]]; then
          c1=${r%%$'\t'*}
          tail=${r#*$'\t'}
          d=$c1"  "${tail//$'\t'/  }
          b=${#c1}
        else
          d=${r//$'\t'/  }
          b=''
        fi
        seg=${d:hx:w}
        pad=${padstr:0:$(( w - ${#seg} ))}
        if [[ -z $b ]] || (( hx + w <= b )); then
          if (( n == sel )); then
            l=$'\e[7m '"$seg$pad"$'\e[0m'
          else
            l=' '"$seg$pad"
          fi
        elif (( hx >= b )); then
          if (( n == sel )); then
            l=' '$'\e[7;2m'"$seg$pad"$'\e[0m'
          else
            l=' '$'\e[2m'"$seg$pad"$'\e[0m'
          fi
        else
          n1=$(( b - hx ))
          p2=${d:hx+n1:w-n1}
          pad2=${padstr:0:$(( w - n1 - ${#p2} ))}
          if (( n == sel )); then
            l=$'\e[7m '"${d:hx:n1}"$'\e[7;2m'"$p2$pad2"$'\e[0m'
          else
            l=' '"${d:hx:n1}"$'\e[2m'"$p2$pad2"$'\e[0m'
          fi
        fi
      fi
      if [[ $l != "${prev[row-1]}" ]]; then
        out+=$'\e['"$row"';1H'"$l"
        prev[row-1]=$l
      fi
    done
    # prompt row: cursor is hidden, so pad to m like the other rows (a
    # shorter rewrite would leave stale characters)
    l=' '${filter:0:m-1}
    l+="${padstr:0:$(( m - ${#l} ))}"
    if [[ $l != "${prev[h]}" ]]; then
      out+=$'\e['$(( h + 1 ))';1H'"$l"
      prev[h]=$l
    fi
    [[ -n $out ]] && printf '%s' "$out" > /dev/tty
  }

  local changed=1
  feeder &
  feeder_pid=$!
  while :; do
    if (( stdin_open )); then
      # drain every batch the feeder has sent (mark: one byte per batch)
      while [[ -s $mark ]]; do
        if ! drain_batch; then
          break
        fi
        : > "$mark"
        printf a >&5
      done
      if [[ -e $eof ]]; then
        stdin_open=0
        if (( ${#items[@]} == 0 )); then
          exit 1
        fi
      fi
    fi
    if [[ $filter != "$filter_prev" ]] || (( dirty )); then
      recompute
      filter_prev=$filter
      dirty=0
      changed=1
    fi
    if (( changed )); then
      render
      changed=0
    fi
    # poll the tty (never the stream: that was the input starvation)
    rc=0
    read -rs -N 1 -t 0.05 key < /dev/tty || rc=$?
    if (( rc > 128 )); then
      continue
    fi
    if (( rc )); then
      rc=1; break
    fi
    # any handled key may change what must be shown (arrows move sel/hx)
    changed=1
    if [[ $key == $'\x1b' ]]; then
      # arrows arrive as 3-byte CSI sequences; read exactly one so a fast
      # next keystroke is not swallowed into this one
      local k2 k3
      if IFS= read -rs -N 1 -t 0.02 k2 < /dev/tty; then
        if [[ $k2 == '[' || $k2 == 'O' ]]; then
          IFS= read -rs -N 1 -t 0.02 k3 < /dev/tty && key+=$k2$k3
        else
          key=$'\x1b'
        fi
      fi
    fi
    case $key in
      $'\x1b[A' | $'\x1bOA')
        # bottom-up list: up = older items (sel+1), down = newer (sel-1)
        if (( sel < ${#shown[@]} - 1 )); then sel=$(( sel + 1 )); fi ;;
      $'\x1b[B' | $'\x1bOB')
        if (( sel > 0 )); then sel=$(( sel - 1 )); fi ;;
      $'\x1b[D' | $'\x1bOD')
        if (( hx > 0 )); then hx=$(( hx - 1 )); fi ;;
      $'\x1b[C' | $'\x1bOC')
        if (( hx < maxl - w )); then hx=$(( hx + 1 )); fi ;;
      $'\x7f' | $'\b') filter=${filter%?} ;;
      $'\x1b') rc=130; break ;;
      $'\n' | $'\r')
        if [[ -n ${shown[sel]-} ]]; then
          printf '%s\n' "${shown[sel]}"
          rc=0
        fi
        break ;;
      *) if [[ ${key:0:1} != [[:cntrl:]] ]]; then filter+=$key; fi ;;
    esac
  done
  exit $rc
}

# main guard: sourceable (tests use tui_filter) without running the picker
[[ ${BASH_SOURCE[0]} == "$0" ]] && main
