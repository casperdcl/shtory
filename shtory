#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# shtory dependencies: jq, rsync, coreutils
set -euo pipefail

# --- helpers ---------------------------------------------------------------

# optional stdin pipe progress
prog() {
  if [[ -t 2 && ${SHTORY_NOPROGRESS:-} != 1 ]] && command -v tqdm >/dev/null 2>&1; then
    tqdm --desc="${1:-}" --unit=rows --unit-scale --leave=False
  else
    cat
  fi
}

usage() {
  cat <<'EOF'
shtory <subcommand> [options]

supercharge bash history: per-host logs with search & serverless sync.

subcommands:
  install [--import]
          add hook & search keybinding to ~/.bashrc
      --import: merges ~/.bash_history into ~/.bash_history.*.jsonl
  uninstall
          remove them again
  help    this text
  search [options] [<query>...]
          interactive on a tty; see below for non-interactive options
  hostname [<name>]
          print (or set) the hostname shtory uses
  sync [--compact <n>] [--self] [<hostname>...]
	  sync histories with host(s) over ssh
	  (default: detect host(s) from ~/.bash_history.*.jsonl filenames)
      --self: also overwrite each host's own history file with the local synced copy
      --compact <n>: while syncing, run compact (implies --self)
  stats [--timeline] [--cmd <n>] [--dir <n>]
          per-host summary
      --timeline: per-host activity histogram over time;
        if SHTORY_GIST_ID is set, also \`gh gist edit\`s
        $SHTORY_GIST_FILE (default shtory.stats)
      --cmd, --dir <n>: most frequent commands/dirs
  compact <n>
          deduplicate & cap each local history file to N lines

search options:
  -h, --hostname <name>   pattern, default: '*' (all hosts)
  -H, --localhost         same as -h="${SHTORY_HOSTNAME:-$HOSTNAME}"
  -c, --cwd               only commands run in $PWD
  -s, --sort <order>      newest (default)/oldest/count
  -n, --limit <n>         max results, default 0 (unlimited)
  -z, --zero              only commands with exit code 0
  -Z, --nonzero           only commands with non-zero exit code
EOF
}

# --- install / uninstall ----------------------------------------------------

MARK_START='# >>> shtory >>>'
MARK_END='# <<< shtory <<<'

bashrc() { printf '%s' "${SHTORY_BASHRC:-$HOME/.bashrc}"; }

# the block appended to ~/.bashrc (quoted heredoc: expanded only in the user's shell)
hook_block() {
  cat <<'EOF'

# >>> shtory >>>
__shtory_log() {
  local ec=${__bp_last_ret_value-$?} h1 cmd esc d re f n
  f="$HOME/.bash_history.${SHTORY_HOSTNAME:-$HOSTNAME}.jsonl"
  re='^[[:space:]]*([0-9]+)[[:space:]]*[*]?[[:space:]]*(.+)$'
  # something earlier in PROMPT_COMMAND may have clobbered $? but saved it in __bp_last_ret_value
  h1=$(builtin history 1 2>/dev/null) || return 0
  [[ $h1 =~ $re ]] || return 0
  # prompt appearing while user typing (input latency):
  # history 1 shows unexecuted line with stale status;
  # skip it (logged at the next prompt).
  (( ${BASH_REMATCH[1]} > HISTCMD )) && return 0
  # grows only on new commands, respecting HISTCONTROL;
  # last entry's index is the list length;
  # non-empty HISTFILE at first prompt means list came from re-read (not from user)
  n=${BASH_REMATCH[1]}
  if [[ -z ${__shtory_last_listlen-} ]]; then
    [[ -s ${HISTFILE:-$HOME/.bash_history} ]] && __shtory_last_listlen=$n || __shtory_last_listlen=$((n - 1))
  fi
  (( n <= __shtory_last_listlen )) && return 0
  __shtory_last_listlen=$n
  cmd=${BASH_REMATCH[2]}
  [[ ${BASH_REMATCH[1]}:$cmd == "${__shtory_last_logged-}" ]] && return 0
  __shtory_last_logged="${BASH_REMATCH[1]}:$cmd"
  if [[ -n ${SHTORY_SKIP-} ]] && [[ $cmd =~ ${SHTORY_SKIP} ]]; then
    return 0
  fi
  esc=${cmd//\\/\\\\}
  esc=${esc//\"/\\\"}
  esc=${esc//$'\n'/\\n}
  esc=${esc//$'\t'/\\t}
  esc=${esc//$'\r'/\\r}
  esc=${esc//[[:cntrl:]]/}
  d=${PWD//\\/\\\\}
  d=${d//\"/\\\"}
  # creation mode 0600
  [[ -f $f ]] || { (umask 077; : >> "$f") 2>/dev/null || true; }
  printf '{"t":%s,"d":"%s","e":%s,"c":"%s"}\n' "${EPOCHSECONDS}" "$d" "$ec" "$esc" >> "$f" 2>/dev/null
  return 0
}
if [[ ${PROMPT_COMMAND-} == *__shtory_log* ]]; then :;
elif (( ${#PROMPT_COMMAND[@]} > 1 )); then
  PROMPT_COMMAND=(__shtory_log ${PROMPT_COMMAND[@]+"${PROMPT_COMMAND[@]}"})
else
  PROMPT_COMMAND="__shtory_log;${PROMPT_COMMAND-}"
fi
__shtory_pick() {
  local sel
  if sel=$(command shtory search "$@"); then
    READLINE_LINE=$sel
    READLINE_POINT=${#sel}
    # force terminal re-init (work-around readline terminal state desync after bind -x)
    kill -WINCH 0 2>/dev/null
  fi
}
if [[ $- == *i* ]]; then
  bind -x "\"${SHTORY_KEY:-\\C-r}\": __shtory_pick"
  _shtory() {
    COMPREPLY=()
    local sub prev cur w
    if (( COMP_CWORD == 1 )); then
      cur=${COMP_WORDS[1]}
      COMPREPLY=($(compgen -W 'install uninstall search hostname sync stats compact help' -- "$cur"))
      return 0
    fi
    sub=${COMP_WORDS[1]} prev=${COMP_WORDS[COMP_CWORD-1]} cur=${COMP_WORDS[COMP_CWORD]}
    local -a hs=() f h
    for f in "$HOME"/.bash_history.*.jsonl; do
      h=${f##*/.bash_history.}; hs+=("${h%.jsonl}")
    done
    case $sub in
      '')
        COMPREPLY=($(compgen -W 'install uninstall search hostname sync stats compact help' -- "$cur"))
        ;;
      install)
        COMPREPLY=($(compgen -W '--import' -- "$cur"))
        ;;
      search)
        case $prev in
          -h|--hostname)
            # no compgen here: a literal '*' in the word list would glob against cwd
            local -a wl=(${hs[@]+"${hs[@]}"} '*' "${SHTORY_HOSTNAME:-$HOSTNAME}")
            COMPREPLY=()
            for w in "${wl[@]}"; do
              [[ $w == "$cur"* ]] && COMPREPLY+=("$w")
            done
            ;;
          -s|--sort)     COMPREPLY=($(compgen -W 'newest oldest count' -- "$cur")) ;;
          -*)            ;;
          *)             COMPREPLY=($(compgen -W '-h --hostname -H --localhost -c --cwd -s --sort -n --limit -z --zero -Z --nonzero --' -- "$cur")) ;;
        esac
        ;;
      sync)
        COMPREPLY=()
        if [[ $cur == -* ]]; then
          COMPREPLY=($(compgen -W '--compact --self' -- "$cur"))
        else
          for w in ${hs[@]+"${hs[@]}"}; do
            [[ $w == "$cur"* ]] && COMPREPLY+=("$w")
          done
        fi
        ;;
      stats)
        COMPREPLY=($(compgen -W '--timeline --cmd --dir' -- "$cur"))
        ;;
    esac
  }
  complete -F _shtory shtory
fi
# <<< shtory <<<
EOF
}

remove_block() { # $1 = bashrc path; rewrite in place, preserving permissions
  local rc=$1 tmp
  tmp=$(mktemp "${rc}.XXXXXX") # same dir as $rc so mv is atomic
  awk -v s="$MARK_START" -v e="$MARK_END" '$0==s{skip=1} $0==e{skip=0; next} !skip' "$rc" > "$tmp"
  chmod --reference="$rc" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$rc"
}

# rewrite $1 in place (preserving permissions), dropping lines matching $2
strip_line() {
  local rcfile=$1 pat=$2 tmp
  tmp=$(mktemp "${rcfile}.XXXXXX")
  grep -vF "$pat" "$rcfile" > "$tmp" || true
  chmod --reference="$rcfile" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$rcfile"
}

# drop t:0 (imported) commands which exist (t:!=0)
drop_stale() {
  jq -c -s '(map(select(.t != 0) | .c) | reduce .[] as $x ({}; .[$x] = true)) as $live
    | map(if .t == 0 and $live[.c] then empty else . end) | .[]'
}

# import from `sort -u ~/.bash_history | grep -v "^#"` with {t:0, d:"", e:0}
# (used by install --import)
import_history() {
  # tmp/tmp2/out: global (EXIT trap on signal exit has no locals)
  local src="$HOME/.bash_history" f n
  tmp='' tmp2=''
  f="$HOME/.bash_history.${SHTORY_HOSTNAME:-$HOSTNAME}.jsonl"
  [[ -r $src ]] || { echo "shtory: no $src to import"; return 0; }
  tmp=$(mktemp)
  trap 'rm -f "${tmp-}" "${tmp2-}" "${out-}"' EXIT
  # strip control chars EXCEPT tab/CR (jq escapes those as \t/\r, matching the logging hook),
  # drop comments, dedupe against commands
  if LC_ALL=C sed 's/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]//g' "$src" \
    | { LC_ALL=C grep -a -v '^#' || true; } \
    | prog import \
    | jq -Rcn --slurpfile ex <( [[ -f $f ]] && cat "$f" ) \
        '($ex | map(.c) | reduce .[] as $x ({}; .[$x] = true)) as $exset
         | [inputs | select(length > 0)]
         | reduce .[] as $c ({}; if ($exset[$c]) or (.[ $c ]) then . else .[$c] = true end)
         | keys_unsorted | .[] | {t:0,d:"",e:0,c:.}' > "$tmp"; then
    n=$(wc -l < "$tmp")
    # stale imports: drop t:0 commands which now exist as t:!=0
    if [[ -f $f ]]; then
      tmp2=$(mktemp)
      if ! drop_stale < "$f" > "$tmp2"; then
        rm -f "$tmp" "$tmp2"
        echo "shtory: import failed" >&2
        return 1
      fi
    fi
    out=$(mktemp "$f.XXXXXX") # 0600, same dir so mv is atomic; redirect truncates (mode-preserving)
    if [[ -f $f ]]; then cat "$tmp" "$tmp2" > "$out"; else cat "$tmp" > "$out"; fi
    if cmp -s "$out" "$f"; then
      rm -f "$out" "$tmp" "$tmp2"
      echo "shtory: nothing to import"
      return 0
    fi
    mv "$out" "$f"
    if (( n > 0 )); then
      echo "shtory: imported $n commands into $f"
    else
      echo "shtory: deduped stale imports from $f"
    fi
    rm -f "$tmp" "$tmp2"
  else
    rm -f "$tmp"
    echo "shtory: import failed" >&2
    return 1
  fi
}

cmd_install() {
  local rcfile import=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --import) import=1; shift ;;
      -*) echo "shtory: unknown install option: $1" >&2; return 2 ;;
    esac
  done
  rcfile=$(bashrc)
  if [[ -f $rcfile ]] && grep -qF "$MARK_START" "$rcfile"; then
    remove_block "$rcfile"
  fi
  hook_block >> "$rcfile"
  echo "shtory: block written to $rcfile — start a new shell (or source it)"
  if (( import )); then
    import_history
  fi
}

cmd_uninstall() {
  local rcfile
  rcfile=$(bashrc)
  local found=0
  if [[ -f $rcfile ]] && grep -qF "$MARK_START" "$rcfile"; then
    remove_block "$rcfile"
    found=1
  fi
  if [[ $found -eq 0 ]]; then
    echo "shtory: no shtory block in $rcfile" >&2
    return 1
  fi
  echo "shtory: block removed from $rcfile — start a new shell (or source it)"
}

# --- search -----------------------------------------------------------------

host_of() { local f=$1; f=${f##*/.bash_history.}; printf '%s' "${f%.jsonl}"; }

# shellcheck disable=SC2016 # $home for jq
TILDE_JQ='def tilde: if $home == "" then . elif . == $home then "~" elif startswith($home + "/") then "~" + .[($home | length):] else . end;'

# shellcheck disable=SC2016 # $vars for jq
JQ_PROG='
# host from the filename .bash_history.<host>.jsonl;
# avoid (possibly jq version unsupported) named captures in sub templates
# $plain=1: query is a plain substring (no regex metachars) -> contains (C-speed memmem, ~4x quicker)
($q | ascii_downcase) as $ql
| def entries:
    . , inputs
    | fromjson? | select(. != null)
    | .H = (if $mode == "cmd" then ""
            elif $H == "" then (input_filename | sub("^.*\\.bash_history\\."; "") | sub("\\.jsonl$"; ""))
            else $H end)
    | select(
      # ascii_downcase: test(...;"i") miscompiles in some jq versions
      (if $q == "" then true
       elif $plain == "1" then ((.c | ascii_downcase) | contains($ql))
       else ((.c | ascii_downcase) | test($ql)) end)
      and (if $d == "" then true else (.d == $d) end)
      and (if $e == "zero" then .e == 0
           elif $e == "nonzero" then .e != 0
           else true end)
    );
   def row:
    .c + "\t" + (.d | tilde) + "\t" + (.e | tostring)
    + "\t" + ((.t | todate | sub("T"; " ") | .[0:16])) + "\t" + .H;
   # rows+none stream line-by-line (the picker; fzf_rows pre-sorts with tac);
   # anything else slurps, sorts, caps
if $mode == "rows" and $o == "none" then
  (if $n == 0 then entries else limit($n; entries) end) | row
else
  [ entries ]
  | ( if $o == "newest" then group_by(.c) | map(max_by(.t)) | sort_by(-.t)
      elif $o == "oldest" then group_by(.c) | map(min_by(.t)) | sort_by(.t)
      elif $o == "count" then group_by(.c) | map({c:.[0].c, d:.[0].d, e:.[0].e, H:.[0].H, t:max_by(.t).t, n:length}) | sort_by(-.n, -.t)
      else . end )
  | (if $n == 0 then . else .[0:$n] end)
  | .[]
  | (if $mode == "rows" then row else .c end)
end
'

# args: query mode(cmd|rows); uses $files $cwd $efilter $order $limit
# shared jq args for query/fzf_rows; uses $cwd $efilter $limit
jq_reset_args() { jqargs=(--arg d "$cwd" --arg e "$efilter" --argjson n "$limit" --arg home "$HOME"); }

query() {
  local q=$1 mode=$2 msg='search'
  command -v fzf >/dev/null 2>&1 || msg="install \`fzf\` to make this search quicker"
  local plain=1 # plain substring (no regex metachars)
  [[ -n ${q//[a-zA-Z0-9_ -]/} ]] && plain=0
  jq_reset_args
  jq -Rr \
    --arg q "$q" --arg o "$order" --arg mode "$mode" --arg plain "$plain" \
    "${jqargs[@]}" --arg H "" "${TILDE_JQ}${JQ_PROG}" "${files[@]}" | prog "$msg"
}

# streaming newest-first rows of t-ordered files
fzf_rows() {
  local f line t
  jq_reset_args
  while IFS=$'\t' read -r t f; do
    tac "$f" | jq -Rr \
      --arg q '' --arg o none --arg mode rows --arg plain 1 \
      "${jqargs[@]}" --arg H "$(host_of "$f")" "${TILDE_JQ}${JQ_PROG}"
  done < <(
    for f in "${files[@]}"; do
      line=$(tail -n 1 "$f" 2>/dev/null)
      if [[ $line =~ \"t\":([0-9]+) ]]; then t=${BASH_REMATCH[1]}; else t=0; fi
      printf '%s\t%s\n' "$t" "$f"
    done | sort -rn
  )
}

search_loop() {
  local q sel out n
  while :; do
    printf 'shtory: pattern (regex, empty=all, q=quit): ' >&2
    read -e -r q || return 1
    [[ $q == [qQ] ]] && return 1
    if ! out=$(query "$q" rows); then
      printf 'search failed (bad regex?) — try again\n' >&2
      continue
    fi
    if [[ -z $out ]]; then
      printf 'no matches\n' >&2
      continue
    fi
    local -a rows=()
    mapfile -t rows <<< "$out"
    for n in "${!rows[@]}"; do
      printf ' %2d  %s\n' "$((n + 1))" "${rows[n]//$'\t'/  }" >&2
    done
    printf 'select [1-%d, q=quit]: ' "${#rows[@]}" >&2
    read -e -r sel || return 1
    [[ $sel == [qQ]* ]] && return 1
    if [[ $sel =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#rows[@]} )); then
      printf '%s\n' "${rows[sel - 1]%%$'\t'*}"
      return 0
    fi
  done
}

cmd_search() {
  local host='*' cwd='' order=newest limit='' efilter='' q='' f h
  local -a files=() query_words=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--hostname) host=${2:?}; shift 2 ;;
      -H|--localhost) host=${SHTORY_HOSTNAME:-$HOSTNAME}; shift ;;
      -c|--cwd) cwd=$PWD; shift ;;
      -s|--sort) order=${2:?}; shift 2 ;;
      -n|--limit) limit=${2:?}; shift 2 ;;
      -z|--zero) efilter=zero; shift ;;
      -Z|--nonzero) efilter=nonzero; shift ;;
      --) shift; while [[ $# -gt 0 ]]; do query_words+=("$1"); shift; done ;;
      -*) echo "shtory: unknown search option: $1" >&2; return 2 ;;
      *) query_words+=("$1"); shift ;;
    esac
  done
  case $order in newest|oldest|count) ;; *) echo "shtory: bad --sort: $order" >&2; return 2 ;; esac
  if [[ -n $limit && ! $limit =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --limit: $limit" >&2; return 2
  fi
  q=${query_words[*]-}

  shopt -s nullglob
  for f in "$HOME"/.bash_history.*.jsonl; do
    h=$(host_of "$f")
    # shellcheck disable=SC2053 # $host glob pattern intended
    [[ $h == $host ]] && files+=("$f")
  done
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "shtory: no history files for host '$host'" >&2
    return 1
  fi

  local interactive=0 picker='' fzf_v sel_row
  local -a picker_opts=()
  if [[ -t 0 && -z $q ]]; then
    interactive=1
    # prefer fzf; but SHTORY_TUI forces tui-shtory fallback
    if [[ -n ${SHTORY_TUI:-} || ! $(command -v fzf) ]]; then
      picker=tui-shtory
      picker_opts=(--freeze-left=1)
    else
      picker=fzf
      picker_opts=(--scheme=history --info=inline-right --border=none --no-scrollbar)
      fzf_v=$(fzf --version 2>/dev/null | awk '{print $1}')
      # --freeze-left needs fzf>=0.67
      [[ $(printf '%s\n0.67.0\n' "$fzf_v" | sort -V | head -n1) == 0.67.0 ]] \
        && picker_opts+=(--freeze-left=1)
    fi
  fi
  if [[ -z $limit ]]; then
    limit=0
  fi
  if [[ $interactive -eq 1 ]]; then
    if [[ -n $picker ]] && command -v "$picker" >/dev/null 2>&1; then
      # pipefail off to allow selecting before stream ends
      if (( limit > 0 )); then
        if ! sel_row=$(set +o pipefail; fzf_rows | head -n "$limit" | "$picker" "${picker_opts[@]}"); then
          return 1
        fi
      else
        if ! sel_row=$(set +o pipefail; fzf_rows | "$picker" "${picker_opts[@]}"); then
          return 1
        fi
      fi
      printf '%s\n' "${sel_row%%$'\t'*}"
      return 0
    fi
    search_loop
  else
    query "$q" cmd
  fi
}

cmd_hostname() {
  if [[ $# -eq 0 ]]; then
    echo "${SHTORY_HOSTNAME:-$HOSTNAME}"
    return 0
  fi
  if [[ $# -gt 1 ]]; then
    echo "shtory: usage: shtory hostname [<host>]" >&2
    return 2
  fi
  local name=$1 rcfile line
  if [[ ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "shtory: invalid hostname: $name" >&2
    return 2
  fi
  rcfile=$(bashrc)
  line="export SHTORY_HOSTNAME=$name"
  strip_line "$rcfile" 'SHTORY_HOSTNAME='
  printf '%s\n' "$line" >> "$rcfile"
  echo "shtory: $line written to $rcfile"
}

# --- sync -------------------------------------------------------------------

# host "exists in ~/.ssh/config" iff ssh -G resolves it to a different hostname
ssh_config_host() {
  local h=$1 hn
  hn=$(ssh -G "$h" 2>/dev/null | awk '$1 == "hostname" {print $2}')
  [[ -n $hn && $hn != "$h" ]]
}

# pull all of $1's history files into $2 (a per-host dir)
sync_pull() {
  local h=$1 dest=$2 rc=0 f
  mkdir -p "$dest"
  # seed with local copies so rsync's quick check skips files the remote hasn't changed
  shopt -s nullglob
  for f in "$HOME"/.bash_history.*.jsonl; do
    cp -p -- "$f" "$dest/"
  done
  shopt -u nullglob
  rsync -zaPu "$h:~/.bash_history.*.jsonl" "$dest/" || rc=$?
  if (( rc == 0 )); then
    return 0
  fi
  # 23/24/30: partial transfer; merge what arrived and warn
  if (( rc == 23 || rc == 24 || rc == 30 )) && compgen -G "$dest/.bash_history.*.jsonl" >/dev/null; then
    echo "shtory: $h: pull incomplete (rsync $rc) - merged what arrived" >&2
    return 0
  fi
  echo "shtory: $h: pull found nothing (or unreachable)" >&2
  return 1
}

# dedupe & t-sort with coreutils
# SHTORY_SAFE = 1: use jq instead (~50x slower but full JSON-compat)
# $1 = tmp dir
# $2 = 1: also drop stale t:0 (imported) entries existing with t:!=0
merge_lines() {
  local dir=$1 drop0=${2-0} t1 t2 live t0c drop
  if [[ ${SHTORY_SAFE:-} == 1 ]]; then
    if [[ $drop0 == 1 ]]; then
      jq -Rc '([. , inputs | fromjson? | select(. != null)] | unique | sort_by(.t)) as $a
        | (($a | map(select(.t != 0) | .c) | reduce .[] as $x ({}; .[$x] = true)) as $live
           | $a | map(if .t == 0 and $live[.c] then empty else . end) | .[])'
    else
      jq -Rc '[. , inputs | fromjson? | select(. != null)] | unique | sort_by(.t) | .[]'
    fi
    return
  fi
  t1=$dir/.m1; t2=$dir/.m2; live=$dir/.m3; t0c=$dir/.m4; drop=$dir/.m5
  LC_ALL=C sort -u > "$t1"
  { LC_ALL=C grep -a '^{"t":' "$t1" || true; } | { LC_ALL=C grep -a '"}$' || true; } > "$t2"
  if [[ $drop0 == 1 ]] && LC_ALL=C grep -qa '^{"t":0,' "$t2"; then
    LC_ALL=C sed -n 's/^{"t":[1-9].*,"c":\(.*\)}$/\1/p' "$t2" | LC_ALL=C sort -u > "$live"
    LC_ALL=C sed -n 's/^{"t":0,"d":"","e":0,"c":\(.*\)}$/\1/p' "$t2" | LC_ALL=C sort > "$t0c"
    LC_ALL=C comm -12 "$live" "$t0c" | sed 's/.*/{"t":0,"d":"","e":0,"c":&}/' > "$drop"
    LC_ALL=C comm -23 "$t2" "$drop" > "$t2.m" && mv "$t2.m" "$t2"
  fi
  LC_ALL=C sort -t: -k2,2n "$t2"
}

# union every pulled copy of each file with the local one; $1 = pull root
sync_merge() {
  local root=$1 f base tmp
  local -a files=() parts=()
  shopt -s nullglob
  for f in "$root"/*/.bash_history.*.jsonl; do
    files+=("$f")
  done
  shopt -u nullglob
  for f in "${files[@]}"; do
    base=${f##*/}
    parts=("$root"/*/"$base")
    [[ -f "$HOME/$base" ]] && parts=("$HOME/$base" "${parts[@]}")
    tmp=$(mktemp "$HOME/$base.XXXXXX") # 0600, same dir so mv is atomic
    if { cat "${parts[@]}"; } | prog merge \
      | merge_lines "$tmpdir" 1 > "$tmp"; then
      if cmp -s -- "$HOME/$base" "$tmp"; then
        rm -f -- "$tmp" # unchanged: keep in-place mtime so the next push is a no-op
      else
        mv -- "$tmp" "$HOME/$base"
      fi
    else
      rm -f "$tmp"
      echo "shtory: merge of $base failed" >&2
    fi
  done
}

# push local files to $1; $2 = the name $1 reports for its own file; $3 = 1 to include it
sync_push() {
  local h=$1 name=$2 self=$3 f base
  local -a push=()
  shopt -s nullglob
  for f in "$HOME"/.bash_history.*.jsonl; do
    base=${f##*/}
    if [[ $base == ".bash_history.$name.jsonl" && $self -ne 1 ]]; then
      continue
    fi
    push+=("$f")
  done
  shopt -u nullglob
  if [[ ${#push[@]} -gt 0 ]]; then
    rsync -zaPu -- "${push[@]}" "$h:~/" || echo "shtory: $h: push failed" >&2
  fi
}

cmd_sync() {
  local -a hosts=()
  local h f cap='' self=0 name rc
  while [[ $# -gt 0 ]]; do
    case $1 in
      --compact) cap=${2:?}; shift 2 ;;
      --self) self=1; shift ;;
      -*) echo "shtory: unknown sync option: $1" >&2; return 2 ;;
      *) hosts+=("$1"); shift ;;
    esac
  done
  if [[ -n $cap && ! $cap =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --compact: $cap" >&2
    return 2
  fi
  [[ -n $cap ]] && self=1 # --compact implies --self
  if [[ ${#hosts[@]} -eq 0 ]]; then
    local localhost=${SHTORY_HOSTNAME:-$HOSTNAME}
    shopt -s nullglob
    for f in "$HOME"/.bash_history.*.jsonl; do
      h=$(host_of "$f")
      [[ $h == "$localhost" ]] && continue # skip self
      hosts+=("$h")
    done
    shopt -u nullglob
  fi
  if [[ ${#hosts[@]} -eq 0 ]]; then
    echo "shtory: no hosts to sync (no local history files & no args)" >&2
    return 1
  fi

  tmpdir=$(mktemp -d) # global (EXIT trap on signal exit has no locals)
  trap 'rm -rf "${tmpdir-}"' EXIT

  local -a pulled=() f
  declare -A name_of=()
  for h in "${hosts[@]}"; do
    if ! ssh_config_host "$h"; then
      echo "shtory: skipping '$h' (not in ~/.ssh/config)" >&2
      continue
    fi
    # name reported by host itself; may differ from ssh alias.
    printf 'shtory: %s: syncing\n' "$h" >&2
    rc=0
    name=$(ssh -o ConnectTimeout=10 "$h" \
      "bash -c 'printf %s \${SHTORY_HOSTNAME:-\$HOSTNAME}'" 2>/dev/null) || rc=$?
    if (( rc == 255 )); then
      echo "shtory: $h: unreachable (skipped)" >&2
      continue
    fi
    name_of[$h]=${name:-$h}
    sync_pull "$h" "$tmpdir/$h" && pulled+=("$h")
  done
  if [[ ${#pulled[@]} -eq 0 ]]; then
    return 0
  fi

  sync_merge "$tmpdir"
  if [[ -n $cap ]]; then
    shopt -s nullglob
    for f in "$HOME"/.bash_history.*.jsonl; do
      compact_file "$f" "$cap"
    done
    shopt -u nullglob
  fi
  for h in "${pulled[@]}"; do
    sync_push "$h" "${name_of[$h]}" "$self"
    if [[ ${name_of[$h]} != "$h" ]]; then
      echo "shtory: $h: synced (as ${name_of[$h]})"
    else
      echo "shtory: $h: synced"
    fi
  done
}

# bin global rows into a $1-cell-wide grid; sets names/bars
timeline_grid() {
  local W=$1 ramp='_▁▂▃▄▅▆▇█' c idx out max f rest h first last i
  local -a cnt=()
  names=(); bars=()
  for r in "${rows[@]}"; do
    f=${r%% *}; rest=${r#* }
    h=${rest%% *}; rest=${rest#* }
    first=${rest%% *}; rest=${rest#* }; last=${rest%%* }
    # per-bin counts over W-cell axis
    mapfile -t cnt < <(awk -v gs="$gstart" -v sp="$span" -v w="$W" '
      { b = (sp > 0) ? int(($1 - gs) * w / sp) : 0
        if (b >= w) b = w - 1
        c[b]++
      } END { for (i = 0; i < w; i++) print c[i] + 0
      }' "$f")
    max=0
    for c in "${cnt[@]}"; do (( c > max )) && max=$c; done
    out=''
    for (( i = 0; i < W; i++ )); do
      c=${cnt[i]}
      if (( c > 0 )); then
        idx=$(( c * 8 / max ))
        out+=${ramp:idx:1}
      else
        out+=' '
      fi
    done
    names+=("$h"); bars+=("$out")
  done
}

timeline_axis() { # $1=W; sets axis from s/e
  axis="$s"
  (( $1 - ${#s} - ${#e} > 0 )) && axis+=$(printf '%*s' "$(( $1 - ${#s} - ${#e} ))" '')
  axis+=$e
}

timeline_lines() { # header + per-host rows into lines[]
  local -a l=()
  local i
  l+=("$(printf '%*s%s  %*s %*s' "$(( namew + 2 ))" '' "$axis" "$wN" cmds "$wD" days)")
  for i in "${!names[@]}"; do
    l+=("$(printf '%-*s  %s  %*s %*s' "$namew" "${names[i]}" "${bars[i]}" "$wN" "${ns[i]}" "$wD" "${ds[i]}")")
  done
  lines=("${l[@]}")
}

# render grid to GitHub $SHTORY_GIST_ID (50 char width)
stats_timeline_gist() {
  local W=$(( 50 - namew - wN - wD - 5 ))
  (( W < 20 )) && W=20
  timeline_grid "$W"
  timeline_axis "$W"
  timeline_lines
  local g="${SHTORY_GIST_FILE:-shtory.stats}"
  g=${g##*/}
  [[ -n $g ]] || g=shtory.stats
  local f="$tmpd/$g" err rc=0
  printf '%s\n' "${lines[@]}" > "$f"
  err=$(gh gist edit "$SHTORY_GIST_ID" -f "$g" "$f" 2>&1) || rc=$?
  if (( rc )) && [[ $err == *"no file"* ]]; then
    err=''; rc=0 # gist has no files yet
    err=$(gh gist edit "$SHTORY_GIST_ID" -a "$g" "$f" 2>&1) || rc=$?
  fi
  if (( rc )); then
    echo "shtory: gist edit: $err" >&2
  else
    echo "shtory: gist $SHTORY_GIST_ID updated"
  fi
  return $rc
}

# per-host activity histogram
stats_timeline() {
  local W=40 f h fl first last n size cols i=0
  rows=(); ns=(); ds=(); gstart=''; gend=''; namew=0; s=''; e=''
  # per-file jq extract t>0 values; awk binning
  tmpd=$(mktemp -d) # global (EXIT trap on signal exit has no locals)
  trap 'rm -rf "${tmpd-}"' EXIT
  for f in "$@"; do
    h=$(host_of "$f")
    local tfile="$tmpd/$i"
    if ! jq -Rr 'fromjson? | select(. != null) | select(.t > 0) | .t' "$f" > "$tfile"; then
      rm -f "$tfile"; continue
    fi
    i=$(( i + 1 ))
    fl=$(awk 'NR==1{mn=mx=$1} {if($1<mn)mn=$1; if($1>mx)mx=$1} END{if(NR)print mn, mx, NR}' "$tfile")
    [[ -n $fl ]] || continue
    first=${fl%% *}; rest=${fl#* }; last=${rest%% *}; n=${rest##* }
    rows+=("$tfile $h $first $last $n")
    (( ${#h} > namew )) && namew=${#h}
    if [[ -z $gstart || $first -lt $gstart ]]; then gstart=$first; fi
    if [[ -z $gend || $last -gt $gend ]]; then gend=$last; fi
  done
  if (( ${#rows[@]} == 0 )); then
    echo "shtory: stats: no history with timestamps (only t:0 imports)" >&2
    return 1
  fi
  # oldest first-used host first (stable for equal first)
  mapfile -t rows < <(printf '%s\n' "${rows[@]}" | sort -k3,3n)
  span=$(( gend - gstart ))
  s=$(date -u -d "@$gstart" +%Y-%m-%d)
  e=$(date -u -d "@$gend" +%Y-%m-%d)
  # row width = name(namew) + 2sp + axis(W) + 2sp + count(wN) + 1sp + days(wD);
  # wN/wD must be known before W can be clamped to the terminal
  local r rest x
  for r in "${rows[@]}"; do
    f=${r%% *}; rest=${r#* }; rest=${rest#* } # drop f, h
    first=${rest%% *}; rest=${rest#* }; last=${rest%% *}; n=${rest##* }
    ns+=("$n"); ds+=("$(( (last - first) / 86400 ))")
  done
  wN=4; wD=4
  for x in "${ns[@]}"; do (( ${#x} > wN )) && wN=${#x}; done
  for x in "${ds[@]}"; do (( ${#x} > wD )) && wD=${#x}; done
  # Termux: [[ -t 1 ]] can report false on a real pty; use the proven stty-via-/dev/tty pattern
  if size=$(stty size < /dev/tty 2>/dev/null); then
    cols=${size#* }
    if (( W > cols - namew - wN - wD - 5 )); then
      W=$(( cols - namew - wN - wD - 5 ))
    fi
  fi
  (( W < 20 )) && W=20 # floor: the two 10-char dates alone need W=20
  timeline_grid "$W"
  timeline_axis "$W"
  timeline_lines
  printf '%s\n' "${lines[@]}"
  if [[ -n ${SHTORY_GIST_ID-} ]]; then
    stats_timeline_gist
    return $?
  fi
  return 0
}

cmd_stats() {
  local cmd='' dir='' timeline='' host f
  local -a files=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --timeline) timeline=1; shift ;;
      --cmd) cmd=${2:?}; shift 2 ;;
      --dir) dir=${2:?}; shift 2 ;;
      *) echo "shtory: unknown stats option: $1" >&2; return 2 ;;
    esac
  done
  if [[ -n $cmd && ! $cmd =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --cmd: $cmd" >&2
    return 2
  fi
  if [[ -n $dir && ! $dir =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --dir: $dir" >&2
    return 2
  fi
  if [[ -n $timeline && ( -n $cmd || -n $dir ) ]]; then
    echo "shtory: stats: --timeline cannot be used with --cmd/--dir" >&2
    return 2
  fi
  shopt -s nullglob
  for f in "$HOME"/.bash_history.*.jsonl; do
    files+=("$f")
  done
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "shtory: no history files" >&2
    return 1
  fi
  if [[ -n $timeline ]]; then
    stats_timeline "${files[@]}"
    return $?
  fi
  if [[ -z $cmd && -z $dir ]]; then
    for f in "${files[@]}"; do
      host=$(host_of "$f")
      jq -Rc --arg h "$host" '[. , inputs | fromjson? | select(. != null)]
        | {host: $h, commands: length,
           first: (if length then ([.[] | select(.t > 0) | .t] | if length > 0 then (min | todate) else null end) else null end),
           last: (if length then (map(.t) | max | todate) else null end),
           failed: ([.[] | select(.e != 0)] | length)}' "$f" || continue
    done
    return 0
  fi
  if [[ -n $cmd ]]; then
    # shellcheck disable=SC2016 # $n for jq
    jq -Rrc --argjson n "$cmd" '
      [ . , inputs | fromjson? | select(. != null) ]
      | group_by(.c) | map({c: .[0].c, n: length}) | sort_by(-.n, .c) | .[0:$n] | .[]
      | (.n | tostring) + "\t" + .c' "${files[@]}"
  fi
  if [[ -n $dir ]]; then
    # shellcheck disable=SC2016 # $n for jq
    jq -Rrc --argjson n "$dir" --arg home "$HOME" \
      "${TILDE_JQ}"'[ . , inputs | fromjson? | select(. != null) ]
      | group_by(.d) | map({d: .[0].d, n: length}) | sort_by(-.n, .d) | .[0:$n] | .[]
      | (.n | tostring) + "\t" + (.d | tilde)' "${files[@]}"
  fi
}

# dedupe + cap $1 (a history file) to the newest $2 lines
compact_file() {
  local f=$1 n=$2 tmp d
  d=$(mktemp -d)
  tmp=$(mktemp "${f}.XXXXXX") # 0600, same dir as $f so mv is atomic
  if { prog "compact" < "$f"; } | merge_lines "$d" 0 \
    | { (( n == 0 )) && cat > /dev/null || tail -n "$n"; } > "$tmp"; then
    mv -- "$tmp" "$f"
  else
    rm -f "$tmp"
    echo "shtory: compact of ${f##*/} failed" >&2
  fi
  rm -rf "$d"
}

cmd_compact() {
  local n=${1-} f
  if [[ $# -ne 1 || ! $n =~ ^[0-9]+$ ]]; then
    echo "shtory: usage: shtory compact <N>" >&2
    return 2
  fi
  shopt -s nullglob
  for f in "$HOME"/.bash_history.*.jsonl; do
    compact_file "$f" "$n"
  done
  shopt -u nullglob
}

# --- dispatch ---------------------------------------------------------------

main() {
  local sub=${1:-help}
  shift || true
  case $sub in
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    search)    cmd_search "$@" ;;
    hostname)  cmd_hostname "$@" ;;
    sync)      cmd_sync "$@" ;;
    stats)     cmd_stats "$@" ;;
    compact)   cmd_compact "$@" ;;
    help|--help) usage ;;
    *) usage >&2; return 2 ;;
  esac
}

main "$@"
