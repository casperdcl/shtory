#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# shtory dependencies: jq, rsync, coreutils
set -euo pipefail

# --- helpers ---------------------------------------------------------------

# optional stdin pipe progress
prog() {
  if [[ -t 2 && ${SHTORY_NOPROGRESS:-} != 1 ]] && command -v tqdm >/dev/null 2>&1; then
    tqdm --desc="${1:-}" --unit=rows --unit-scale --leave=False
  else
    cat
  fi
}

usage() {
  cat <<'EOF'
shtory <subcommand> [options]

supercharge shell history: per-host logs with search & serverless sync.

subcommands:
  install [--import]
          add hook & search keybinding
          (bash: ~/.bashrc, zsh: ~/.zshrc)
      --import: merges $HISTFILE into ~/.shtory/*.jsonl
  uninstall
          remove them again
  help    this text
  search [options] [<query>...]
          interactive on a tty; see below for non-interactive options
  hostname [<name>]
          print (or set) the hostname shtory uses
  sync [--compact <n>] [--self] [<hostname>...]
	  sync histories with host(s) over ssh
	  (default: detect host(s) from ~/.shtory/*.jsonl filenames)
      --self: also overwrite each host's own history file with the local synced copy
      --compact <n>: while syncing, run compact (implies --self)
  stats [--timeline] [--cmd <n>] [--dir <n>]
          per-host summary
      --timeline: per-host activity histogram over time;
        if SHTORY_GIST_ID is set, also \`gh gist edit\`s
        $SHTORY_GIST_FILE (default shtory.stats)
      --cmd, --dir <n>: most frequent commands/dirs
  compact <n>
          deduplicate & cap each local history file to N lines

search options:
  -h, --hostname <name>   pattern, default: '*' (all hosts)
  -H, --localhost         same as -h="$SHTORY_HOSTNAME"
  -c, --cwd               only commands run in $PWD
  -s, --sort <order>      frecency (default)/newest/oldest/count
                          (interactive: newest)
  -n, --limit <n>         max results, default 0 (unlimited)
  -z, --zero              only commands with exit code 0
  -Z, --nonzero           only commands with non-zero exit code
EOF
}

# --- install / uninstall ----------------------------------------------------

MARK_START='# >>> shtory >>>'
MARK_END='# <<< shtory <<<'

bashrc() { printf '%s' "${SHTORY_BASHRC:-$HOME/.bashrc}"; }
zshrc() { printf '%s' "${SHTORY_ZSHRC:-$HOME/.zshrc}"; }

# the block appended to ~/.bashrc (quoted heredoc: expanded only in the user's shell)
hook_block_bash() {
  cat <<'EOF'

# >>> shtory >>>
__shtory_log() {
  local ec=${__bp_last_ret_value:-$?} h1 cmd esc d re f n
  # hostname: $SHTORY_HOSTNAME > ~/.shtory/shtory.env > $HOSTNAME; cached per shell
  if [[ -z ${SHTORY_HOSTNAME-} && -z ${__shtory_host-} && -f $HOME/.shtory/shtory.env ]]; then
    __shtory_host=$(grep ^SHTORY_HOSTNAME= "$HOME/.shtory/shtory.env" 2>/dev/null | tail -n1 | cut -d= -f2-)
  fi
  f="$HOME/.shtory/${SHTORY_HOSTNAME:-${__shtory_host:-$HOSTNAME}}.jsonl"
  re='^[[:space:]]*([0-9]+)[[:space:]]*[*]?[[:space:]]*(.+)$'
  # something earlier in PROMPT_COMMAND may have clobbered $? but saved it in __bp_last_ret_value
  h1=$(builtin history 1 2>/dev/null) || return 0
  n=0
  [[ $h1 =~ $re ]] && n=${BASH_REMATCH[1]}
  # n: list length; grows per command (HISTCONTROL respected),
  # so log the last entry only when the list grew since the previous prompt.
  # At first prompt, may only hold re-read (HISTFILE) or read-ahead (not yet executed) lines: never logged.
  if [[ -z ${__shtory_last_listlen-} ]]; then
    __shtory_last_listlen=$n
    return 0
  fi
  # list shrank (history -c/-d restarted numbering): re-baseline
  (( n < __shtory_last_listlen )) && __shtory_last_listlen=$n
  (( n <= __shtory_last_listlen )) && return 0
  __shtory_last_listlen=$n
  cmd=${BASH_REMATCH[2]}
  [[ ${BASH_REMATCH[1]}:$cmd == "${__shtory_last_logged-}" ]] && return 0
  __shtory_last_logged="${BASH_REMATCH[1]}:$cmd"
  if [[ -n ${SHTORY_SKIP-} ]] && [[ $cmd =~ ${SHTORY_SKIP} ]]; then
    return 0
  fi
  esc=${cmd//\\/\\\\}
  esc=${esc//\"/\\\"}
  esc=${esc//$'\n'/\\n}
  esc=${esc//$'\t'/\\t}
  esc=${esc//$'\r'/\\r}
  esc=${esc//[[:cntrl:]]/}
  d=${PWD//\\/\\\\}
  d=${d//\"/\\\"}
  # creation: dir 0700, file 0600
  [[ -f $f ]] || { (umask 077; mkdir -p "$HOME/.shtory" 2>/dev/null; : >> "$f") 2>/dev/null || true; }
  printf '{"t":%s,"d":"%s","e":%s,"c":"%s"}\n' "${EPOCHSECONDS:-$(date +%s)}" "$d" "$ec" "$esc" >> "$f" 2>/dev/null
  return 0
}
if [[ ${PROMPT_COMMAND-} == *__shtory_log* ]]; then :;
elif (( ${#PROMPT_COMMAND[@]} > 1 )); then
  PROMPT_COMMAND=(__shtory_log ${PROMPT_COMMAND[@]+"${PROMPT_COMMAND[@]}"})
else
  PROMPT_COMMAND="__shtory_log;${PROMPT_COMMAND-}"
fi
__shtory_pick() {
  local sel
  if sel=$(command shtory search "$@"); then
    READLINE_LINE=$sel
    READLINE_POINT=${#sel}
    # force terminal re-init (work-around readline terminal state desync after bind -x)
    kill -WINCH 0 2>/dev/null
  fi
}
if [[ $- == *i* ]]; then
  bind -x "\"${SHTORY_KEY:-\\C-r}\": __shtory_pick"
  _shtory() {
    COMPREPLY=()
    local sub prev cur w
    if (( COMP_CWORD == 1 )); then
      cur=${COMP_WORDS[1]}
      COMPREPLY=($(compgen -W 'install uninstall search hostname sync stats compact help' -- "$cur"))
      return 0
    fi
    sub=${COMP_WORDS[1]} prev=${COMP_WORDS[COMP_CWORD-1]} cur=${COMP_WORDS[COMP_CWORD]}
    local -a hs=() f h
    for f in "$HOME"/.shtory/*.jsonl; do
      h=${f##*/}; hs+=("${h%.jsonl}")
    done
    case $sub in
      '')
        COMPREPLY=($(compgen -W 'install uninstall search hostname sync stats compact help' -- "$cur"))
        ;;
      install)
        COMPREPLY=($(compgen -W '--import' -- "$cur"))
        ;;
      search)
        case $prev in
          -h|--hostname)
            # no compgen here: a literal '*' in the word list would glob against cwd
            local -a wl=(${hs[@]+"${hs[@]}"} '*' "${SHTORY_HOSTNAME:-$HOSTNAME}")
            COMPREPLY=()
            for w in "${wl[@]}"; do
              [[ $w == "$cur"* ]] && COMPREPLY+=("$w")
            done
            ;;
          -s|--sort)     COMPREPLY=($(compgen -W 'frecency newest oldest count' -- "$cur")) ;;
          -*)            ;;
          *)             COMPREPLY=($(compgen -W '-h --hostname -H --localhost -c --cwd -s --sort -n --limit -z --zero -Z --nonzero --' -- "$cur")) ;;
        esac
        ;;
      sync)
        COMPREPLY=()
        if [[ $cur == -* ]]; then
          COMPREPLY=($(compgen -W '--compact --self' -- "$cur"))
        else
          for w in ${hs[@]+"${hs[@]}"}; do
            [[ $w == "$cur"* ]] && COMPREPLY+=("$w")
          done
        fi
        ;;
      stats)
        COMPREPLY=($(compgen -W '--timeline --cmd --dir' -- "$cur"))
        ;;
    esac
  }
  complete -F _shtory shtory
fi
# <<< shtory <<<
EOF
}

# the block appended to ~/.zshrc (quoted heredoc: expanded only in the user's shell)
# zshaddhistory fires when a line is added to the history list, before zsh's own
# filtering, so HIST_IGNORE_DUPS/HIST_IGNORE_SPACE are mirrored in __shtory_zshaddhistory;
# precmd then writes it with the command's exit code
hook_block_zsh() {
  cat <<'EOF'

# >>> shtory >>>
zmodload zsh/datetime 2>/dev/null # EPOCHSECONDS
autoload -Uz add-zsh-hook
__shtory_zshaddhistory() {
  local cmd=${1%$'\n'}
  [[ -n $cmd ]] || return 0
  # the hook fires before zsh's own history filtering, so mirror it:
  if [[ $cmd == ' '* ]] && [[ -o hist_ignore_space ]]; then
    return 0
  fi
  # dups mirror is consecutive-only: hist_ignore_all_dups also skips
  # non-consecutive repeats (accepted: search dedupes by command anyway)
  if [[ $cmd == "${__shtory_last-}" ]] && [[ -o hist_ignore_dups || -o hist_ignore_all_dups ]]; then
    return 0
  fi
  __shtory_last=$cmd
  if [[ -n ${SHTORY_SKIP-} ]] && [[ $cmd =~ ${SHTORY_SKIP} ]]; then
    return 0
  fi
  __shtory_cmd=$cmd
}
__shtory_log() {
  # $? is the last command's exit status: zsh restores it before each precmd hook
  local ec=$?
  local cmd=${__shtory_cmd-}
  [[ -n $cmd ]] || return 0
  unset __shtory_cmd
  local esc d f t
  esc=${cmd//\\/\\\\}
  esc=${esc//\"/\\\"}
  esc=${esc//$'\n'/\\n}
  esc=${esc//$'\t'/\\t}
  esc=${esc//$'\r'/\\r}
  esc=${esc//[[:cntrl:]]/}
  d=${PWD//\\/\\\\}
  d=${d//\"/\\\"}
  # hostname: $SHTORY_HOSTNAME > ~/.shtory/shtory.env > $HOST; cached per shell
  if [[ -z ${SHTORY_HOSTNAME-} && -z ${__shtory_host-} && -f $HOME/.shtory/shtory.env ]]; then
    __shtory_host=$(grep ^SHTORY_HOSTNAME= "$HOME/.shtory/shtory.env" 2>/dev/null | tail -n1 | cut -d= -f2-)
  fi
  f="$HOME/.shtory/${SHTORY_HOSTNAME:-${__shtory_host:-$HOST}}.jsonl"
  t=${EPOCHSECONDS:-$(date +%s)}
  # creation: dir 0700, file 0600
  [[ -f $f ]] || { (umask 077; mkdir -p "$HOME/.shtory" 2>/dev/null; : >> "$f") 2>/dev/null || true; }
  printf '{"t":%s,"d":"%s","e":%s,"c":"%s"}\n' "$t" "$d" "$ec" "$esc" >> "$f" 2>/dev/null
  return 0
}
add-zsh-hook zshaddhistory __shtory_zshaddhistory
add-zsh-hook precmd __shtory_log
__shtory_pick() {
  local sel
  zle -I # interrupt any pending widget (e.g. vi-mode char wait)
  # inside a widget, $(...) stdin is a pipe; the tty goes to /dev/tty
  # (fzf/tui-shtory read keys from there anyway; the numbered loop needs it)
  if sel=$(command shtory search < /dev/tty); then
    LBUFFER=$sel
    RBUFFER=
    zle reset-prompt
  fi
}
zle -N __shtory_pick
bindkey "${SHTORY_KEY:-\C-r}" __shtory_pick
if (( ${+functions[compdef]} )); then
  # only when the user's zshrc has loaded the completion system
  __shtory_comps() {
    local sub cur h
    local -a hs f reply
    cur=${words[CURRENT]}
    if (( CURRENT == 2 )); then
      reply=(install uninstall search hostname sync stats compact help)
      return
    fi
    sub=${words[2]}
    for f in "$HOME"/.shtory/*.jsonl(N); do
      h=${f##*/}
      hs+=("${h%.jsonl}")
    done
    case $sub in
      install) reply=(--import) ;;
      search)
        case ${words[CURRENT-1]} in
          -h|--hostname) reply=($hs '*' "${SHTORY_HOSTNAME:-$HOST}") ;;
          -s|--sort)     reply=(frecency newest oldest count) ;;
          -*) ;;
          *) reply=(-h --hostname -H --localhost -c --cwd -s --sort -n --limit -z --zero -Z --nonzero) ;;
        esac ;;
      sync)
        if [[ $cur == -* ]]; then reply=(--compact --self); else reply=($hs); fi ;;
      stats) reply=(--timeline --cmd --dir) ;;
    esac
  }
  compdef __shtory_comps shtory
fi
# <<< shtory <<<
EOF
}

remove_block() { # $1 = rcfile (rewrite in place, preserving permissions)
  local rcfile=$1 tmp
  tmp=$(mktemp "${rcfile}.XXXXXX") # same dir as $rcfile so mv is atomic
  awk -v s="$MARK_START" -v e="$MARK_END" '
    BEGIN { have = 0; skip = 0 }
    skip { if ($0 == e) skip = 0; next }
    $0 == s {
      if (have && prev != "") print prev
      skip = 1; have = 0; next
    }
    { if (have) print prev; prev = $0; have = 1 }
    END { if (have && !skip) print prev }
  ' "$rcfile" > "$tmp"
  mode=$(stat -c %a "$rcfile" 2>/dev/null || stat -f %Lp "$rcfile" 2>/dev/null)
  [[ -n $mode ]] && chmod "$mode" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$rcfile"
}

# drop t:0 (imported) commands which exist (t:!=0)
drop_stale() {
  jq -c -s '(map(select(.t != 0) | .c) | reduce .[] as $x ({}; .[$x] = true)) as $live
    | map(if .t == 0 and $live[.c] then empty else . end) | .[]'
}

# import from `sort -u $HISTFILE | grep -v "^#"` with {t:0, d:"", e:0}
# (used by install --import)
import_history() {
  # tmp/tmp2/out: global (EXIT trap on signal exit has no locals)
  local src f n
  if [[ ${SHELL##*/} == zsh ]]; then
    src="${HISTFILE:-$HOME/.zsh_history}"
  else
    src="${HISTFILE:-$HOME/.bash_history}"
  fi
  tmp='' tmp2=''
  f="$HOME/.shtory/$SHTORY_HOSTNAME.jsonl"
  [[ -r $src ]] || { echo "shtory: no $src to import"; return 0; }
  (umask 077; mkdir -p "$HOME/.shtory")
  tmp=$(mktemp)
  trap 'rm -f "${tmp-}" "${tmp2-}" "${out-}"' EXIT
  # strip control chars EXCEPT tab/CR (jq escapes those as \t/\r, matching the logging hook),
  # drop comments + zsh extended_history ": <ts>:<s>;" prefixes, dedupe against commands
  # tr -d: BSD sed has no \xHH in bracket expressions
  if LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' < "$src" \
    | LC_ALL=C sed -e 's/^: [0-9]*:[0-9]*;//' \
    | { LC_ALL=C grep -a -v '^#' || true; } \
    | prog import \
    | jq -Rcn --slurpfile ex <( [[ -f $f ]] && cat "$f" ) \
        '($ex | map(.c) | reduce .[] as $x ({}; .[$x] = true)) as $exset
         | [inputs | select(length > 0)]
         | reduce .[] as $c ({}; if ($exset[$c]) or (.[ $c ]) then . else .[$c] = true end)
         | keys_unsorted | .[] | {t:0,d:"",e:0,c:.}' > "$tmp"; then
    n=$(wc -l < "$tmp" | tr -d '[:space:]')
    # stale imports: drop t:0 commands which now exist as t:!=0
    if [[ -f $f ]]; then
      tmp2=$(mktemp)
      if ! drop_stale < "$f" > "$tmp2"; then
        rm -f "$tmp" "$tmp2"
        echo "shtory: import failed" >&2
        return 1
      fi
    fi
    out=$(mktemp "$f.XXXXXX") # 0600, same dir so mv is atomic; redirect truncates (mode-preserving)
    if [[ -f $f ]]; then cat "$tmp" "$tmp2" > "$out"; else cat "$tmp" > "$out"; fi
    if cmp -s "$out" "$f"; then
      rm -f "$out" "$tmp" "$tmp2"
      echo "shtory: nothing to import"
      return 0
    fi
    mv "$out" "$f"
    if (( n > 0 )); then
      echo "shtory: imported $n commands into $f"
    else
      echo "shtory: deduped stale imports from $f"
    fi
    rm -f "$tmp" "$tmp2"
  else
    rm -f "$tmp"
    echo "shtory: import failed" >&2
    return 1
  fi
}

cmd_install() {
  local rcfile import=0 shell block
  while [[ $# -gt 0 ]]; do
    case $1 in
      --import) import=1; shift ;;
      *) echo "shtory: unknown install option: $1" >&2; return 2 ;;
    esac
  done
  [[ ${SHELL##*/} == zsh ]] && shell=zsh || shell=bash
  if [[ $shell == zsh ]]; then
    rcfile=$(zshrc); block=hook_block_zsh
  else
    rcfile=$(bashrc); block=hook_block_bash
  fi
  if [[ -f $rcfile ]] && grep -qF "$MARK_START" "$rcfile"; then
    remove_block "$rcfile"
  fi
  "$block" >> "$rcfile"
  echo "shtory: block written to $rcfile — start a new shell (or source it)"
  if (( import )); then
    import_history
  fi
}

cmd_uninstall() {
  local rcfile
  if [[ ${SHELL##*/} == zsh ]]; then
    rcfile=$(zshrc)
  else
    rcfile=$(bashrc)
  fi
  if [[ -f $rcfile ]] && grep -qF "$MARK_START" "$rcfile"; then
    remove_block "$rcfile"
    echo "shtory: block removed from $rcfile — start a new shell (or source it)"
  else
    echo "shtory: no shtory block in $rcfile" >&2
    return 1
  fi
}

# --- search -----------------------------------------------------------------

host_of() { local f=$1; f=${f##*/}; printf '%s' "${f%.jsonl}"; }

# shellcheck disable=SC2016 # $home for jq
TILDE_JQ='def tilde: if $home == "" then . elif . == $home then "~" elif startswith($home + "/") then "~" + .[($home | length):] else . end;'

# per-line query filter is a bash-selected program fragment (qfrag): keeps no-query select-free (fast)
JQ_ROW='def row: .c + "\t" + (.d | tilde)
  + "\t" + (.e | tostring)
  + "\t" + ((.t | todate | .[0:10] + " " + .[11:16])) + "\t" + .H;'
JQ_ROWS='inputs | fromjson? | select(. != null)'
# shellcheck disable=SC2016 # $d $e for jq
JQ_DE='select((if $d == "" then true else .d == $d end)
  and (if $e == "zero" then .e == 0 elif $e == "nonzero" then .e != 0 else true end))'
# shellcheck disable=SC2016 # $o $n for jq
JQ_CMD_ORDER='| ( if $o == "newest" then group_by(.c) | map(max_by(.t)) | sort_by(-.t)
      elif $o == "oldest" then group_by(.c) | map(min_by(.t)) | sort_by(.t)
      elif $o == "count" then group_by(.c) | map({c:.[0].c, d:.[0].d, e:.[0].e, H:.[0].H, t:max_by(.t).t, n:length}) | sort_by(-.n, -.t)
      elif $o == "frecency" then group_by(.c) | map({c:.[0].c, d:.[0].d, e:.[0].e, H:.[0].H, t:max_by(.t).t, s:(length * pow(2; (max_by(.t).t - now) / (30*86400)))}) | sort_by(-.s, -.t)
      else . end )
  | (if $n == 0 then . else .[0:$n] end)'
# shellcheck disable=SC2016 # $H $n for jq
JQ_ROWS_TAIL=' | .H = $H | (if $n == 0 then . else limit($n; .) end) | row'

# per-line query filter fragment (empty when $q is empty); $ql is the lowercased query
qfrag() {
  if [[ -n $q ]]; then
    # shellcheck disable=SC2016 # $ql for jq
    if (( plain )); then printf '| select(((.c | ascii_downcase) | contains($ql)))'
    else printf '| select(((.c | ascii_downcase) | test($ql)))'; fi
  fi
}

# tac else awk fallback
TAC_BIN=$(command -v tac 2>/dev/null || true)
reverse_file() {
  if [[ -n $TAC_BIN ]]; then "$TAC_BIN" "$1"
  else awk '{ a[NR] = $0 } END { for (i = NR; i > 0; i--) print a[i] }' "$1"; fi
}

# args: query mode(cmd|rows); uses $files $cwd $efilter $order $limit
# shared jq args for query/fzf_rows; uses $cwd $efilter $limit
jq_reset_args() { jqargs=(--arg d "$cwd" --arg e "$efilter" --argjson n "$limit" --arg home "$HOME"); }

# $1 <= $2
ver_ge() {
  awk -v a="$1" -v b="$2" '
    BEGIN { n = split(a, A, "."); m = split(b, B, ".")
      for (i = 1; i <= (n > m ? n : m); i++) {
        x = (i <= n ? A[i] : 0) + 0; y = (i <= m ? B[i] : 0) + 0
        if (x > y) exit 1
        if (x < y) exit 0
      } exit 0 }' >/dev/null
}

query() {
  local q=$1 mode=$2 msg='search' f jqprog
  command -v fzf >/dev/null 2>&1 || msg="install \`fzf\` to make this search quicker"
  local plain=1 # plain substring (no regex metachars)
  [[ -n ${q//[a-zA-Z0-9_ -]/} ]] && plain=0
  local ql
  ql=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
  jq_reset_args
  if [[ $mode == rows && $order == none ]]; then
    # per-file stream (no cross-file ordering): .H known per file, no input_filename
    jqprog="${TILDE_JQ}${JQ_ROW}${JQ_ROWS}$(qfrag) | ${JQ_DE}${JQ_ROWS_TAIL}"
    for f in "${files[@]}"; do
      jq -nRr --argjson n "$limit" --arg ql "$ql" "${jqargs[@]}" --arg H "$(host_of "$f")" "$jqprog" "$f"
    done | prog "$msg"
  else
    # slurp + order (cross-file); .H from the filename
    local out hass=''
    if [[ $mode == rows ]]; then out=row hass=' | .H = (input_filename | sub("^.*\\.shtory/"; "") | sub("\\.jsonl$"; ""))'
    else out=.c; fi
    jqprog="${TILDE_JQ}${JQ_ROW}[ ${JQ_ROWS}$(qfrag) | ${JQ_DE}${hass} ] ${JQ_CMD_ORDER} | .[] | $out"
    jq -nRr --arg o "$order" --argjson n "$limit" --arg ql "$ql" "${jqargs[@]}" --arg H "" "$jqprog" "${files[@]}" | prog "$msg"
  fi
}

# streaming newest-first rows of t-ordered files
fzf_rows() {
  local f line t
  jq_reset_args
  local jqprog="${TILDE_JQ}${JQ_ROW}${JQ_ROWS} | ${JQ_DE}${JQ_ROWS_TAIL}"
  while IFS=$'\t' read -r t f; do
    # || break: picker cancelled -> stop producing (consumer's stdin is closed)
    reverse_file "$f" | jq -nRr "${jqargs[@]}" --arg H "$(host_of "$f")" "$jqprog" || break
  done < <(
    for f in "${files[@]}"; do
      line=$(tail -n 1 "$f" 2>/dev/null)
      if [[ $line =~ \"t\":([0-9]+) ]]; then t=${BASH_REMATCH[1]}; else t=0; fi
      printf '%s\t%s\n' "$t" "$f"
    done | sort -rn
  )
}

search_loop() {
  local q sel out n
  while :; do
    printf 'shtory: pattern (regex, empty=all, q=quit): ' >&2
    read -e -r q || return 1
    [[ $q == [qQ] ]] && return 1
    if ! out=$(query "$q" rows); then
      printf 'search failed (bad regex?) — try again\n' >&2
      continue
    fi
    if [[ -z $out ]]; then
      printf 'no matches\n' >&2
      continue
    fi
    local -a rows=()
    while IFS= read -r l; do rows+=("$l"); done <<< "$out"
    for n in "${!rows[@]}"; do
      printf ' %2d  %s\n' "$((n + 1))" "${rows[n]//$'\t'/  }" >&2
    done
    printf 'select [1-%d, q=quit]: ' "${#rows[@]}" >&2
    read -e -r sel || return 1
    [[ $sel == [qQ]* ]] && return 1
    if [[ $sel =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#rows[@]} )); then
      printf '%s\n' "${rows[sel - 1]%%$'\t'*}"
      return 0
    fi
  done
}

cmd_search() {
  local host='*' cwd='' order=frecency limit='' efilter='' q='' f h
  local -a files=() query_words=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--hostname) host=${2:?}; shift 2 ;;
      -H|--localhost) host=$SHTORY_HOSTNAME; shift ;;
      -c|--cwd) cwd=$PWD; shift ;;
      -s|--sort) order=${2:?}; shift 2 ;;
      -n|--limit) limit=${2:?}; shift 2 ;;
      -z|--zero) efilter=zero; shift ;;
      -Z|--nonzero) efilter=nonzero; shift ;;
      --) shift; while [[ $# -gt 0 ]]; do query_words+=("$1"); shift; done ;;
      -*) echo "shtory: unknown search option: $1" >&2; return 2 ;;
      *) query_words+=("$1"); shift ;;
    esac
  done
  case $order in newest|oldest|count|frecency) ;; *) echo "shtory: bad --sort: $order" >&2; return 2 ;; esac
  if [[ -n $limit && ! $limit =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --limit: $limit" >&2; return 2
  fi
  q=${query_words[*]-}

  shopt -s nullglob
  for f in "$HOME"/.shtory/*.jsonl; do
    h=$(host_of "$f")
    # shellcheck disable=SC2053 # $host glob pattern intended
    [[ $h == $host ]] && files+=("$f")
  done
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "shtory: no history files for host '$host'" >&2
    return 1
  fi

  local interactive=0 picker='' fzf_v sel_row
  local -a picker_opts=()
  if [[ -t 0 && -z $q ]]; then
    interactive=1
    # prefer fzf; but SHTORY_TUI forces tui-shtory fallback
    if [[ -n ${SHTORY_TUI:-} || ! $(command -v fzf) ]]; then
      picker=tui-shtory
      picker_opts=(--freeze-left=1)
    else
      picker=fzf
      picker_opts=(--scheme=history --info=inline-right --border=none --no-scrollbar)
      fzf_v=$(fzf --version 2>/dev/null | awk '{print $1}')
      # --freeze-left needs fzf>=0.67
      ver_ge 0.67.0 "$fzf_v" && picker_opts+=(--freeze-left=1)
    fi
  fi
  if [[ -z $limit ]]; then
    limit=0
  fi
  if [[ $interactive -eq 1 ]]; then
    if [[ -n $picker ]] && command -v "$picker" >/dev/null 2>&1; then
      # pipefail off to allow selecting before stream ends
      if (( limit > 0 )); then
        if ! sel_row=$(set +o pipefail; fzf_rows | head -n "$limit" | "$picker" "${picker_opts[@]}"); then
          return 1
        fi
      else
        if ! sel_row=$(set +o pipefail; fzf_rows | "$picker" "${picker_opts[@]}"); then
          return 1
        fi
      fi
      # fzf exits 0 with no output on Enter over an empty list: treat as cancel
      # (an empty selection would wipe READLINE_LINE in __shtory_pick)
      [[ -n $sel_row ]] || return 1
      printf '%s\n' "${sel_row%%$'\t'*}"
      return 0
    fi
    search_loop
  else
    query "$q" cmd
  fi
}

cmd_hostname() {
  if [[ $# -eq 0 ]]; then
    echo "$SHTORY_HOSTNAME"
    return 0
  fi
  if [[ $# -gt 1 ]]; then
    echo "shtory: usage: shtory hostname [<host>]" >&2
    return 2
  fi
  local name=$1
  if [[ ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "shtory: invalid hostname: $name" >&2
    return 2
  fi
  (umask 077; mkdir -p "$HOME/.shtory")
  printf 'SHTORY_HOSTNAME=%s\n' "$name" > "$HOME/.shtory/shtory.env"
  echo "shtory: SHTORY_HOSTNAME=$name written to $HOME/.shtory/shtory.env"
}

# --- sync -------------------------------------------------------------------

# host "exists in ~/.ssh/config" iff ssh -G resolves it to a different hostname
ssh_config_host() {
  local h=$1 hn
  hn=$(ssh -G "$h" 2>/dev/null | awk '$1 == "hostname" {print $2}')
  [[ -n $hn && $hn != "$h" ]]
}

# pull all of $1's history files into $2 (a per-host dir)
sync_pull() {
  local h=$1 dest=$2 rc=0 f
  mkdir -p "$dest"
  # seed with local copies so rsync's quick check skips files the remote hasn't changed
  shopt -s nullglob
  for f in "$HOME"/.shtory/*.jsonl; do
    cp -p -- "$f" "$dest/"
  done
  shopt -u nullglob
  rsync -zaPu "$h:~/.shtory/*.jsonl" "$dest/" || rc=$?
  if (( rc == 0 )); then
    return 0
  fi
  # 23/24/30: partial transfer; merge what arrived and warn
  if (( rc == 23 || rc == 24 || rc == 30 )) && compgen -G "$dest/*.jsonl" >/dev/null; then
    echo "shtory: $h: pull incomplete (rsync $rc) - merged what arrived" >&2
    return 0
  fi
  echo "shtory: $h: pull found nothing (or unreachable)" >&2
  return 1
}

# dedupe & t-sort with coreutils
# SHTORY_SAFE = 1: use jq instead (~50x slower but full JSON-compat)
# $1 = tmp dir
# $2 = 1: also drop stale t:0 (imported) entries existing with t:!=0
merge_lines() {
  local dir=$1 drop0=${2-0} t1 t2 live t0c drop
  if [[ ${SHTORY_SAFE:-} == 1 ]]; then
    if [[ $drop0 == 1 ]]; then
      jq -Rc '([. , inputs | fromjson? | select(. != null)] | unique | sort_by(.t)) as $a
        | (($a | map(select(.t != 0) | .c) | reduce .[] as $x ({}; .[$x] = true)) as $live
           | $a | map(if .t == 0 and $live[.c] then empty else . end) | .[])'
    else
      jq -Rc '[. , inputs | fromjson? | select(. != null)] | unique | sort_by(.t) | .[]'
    fi
    return
  fi
  t1=$dir/.m1; t2=$dir/.m2; live=$dir/.m3; t0c=$dir/.m4; drop=$dir/.m5
  LC_ALL=C sort -u > "$t1"
  { LC_ALL=C grep -a '^{"t":' "$t1" || true; } | { LC_ALL=C grep -a '"}$' || true; } > "$t2"
  if [[ $drop0 == 1 ]] && LC_ALL=C grep -qa '^{"t":0,' "$t2"; then
    LC_ALL=C sed -n 's/^{"t":[1-9].*,"c":\(.*\)}$/\1/p' "$t2" | LC_ALL=C sort -u > "$live"
    LC_ALL=C sed -n 's/^{"t":0,"d":"","e":0,"c":\(.*\)}$/\1/p' "$t2" | LC_ALL=C sort > "$t0c"
    LC_ALL=C comm -12 "$live" "$t0c" | sed 's/.*/{"t":0,"d":"","e":0,"c":&}/' > "$drop"
    LC_ALL=C comm -23 "$t2" "$drop" > "$t2.m" && mv "$t2.m" "$t2"
  fi
  LC_ALL=C sort -t: -k2,2n "$t2"
}

# union every pulled copy of each file with the local one; $1 = pull root
sync_merge() {
  local root=$1 f base tmp
  local -a files=() parts=()
  shopt -s nullglob
  for f in "$root"/*/*.jsonl; do
    files+=("$f")
  done
  shopt -u nullglob
  for f in "${files[@]}"; do
    base=${f##*/}
    parts=("$root"/*/"$base")
    [[ -f "$HOME/.shtory/$base" ]] && parts=("$HOME/.shtory/$base" "${parts[@]}")
    tmp=$(mktemp "$HOME/.shtory/$base.XXXXXX") # 0600, same dir so mv is atomic
    if { cat "${parts[@]}"; } | prog merge \
      | merge_lines "$tmpdir" 1 > "$tmp"; then
      if cmp -s -- "$HOME/.shtory/$base" "$tmp"; then
        rm -f -- "$tmp" # unchanged: keep in-place mtime so the next push is a no-op
      else
        mv -- "$tmp" "$HOME/.shtory/$base"
      fi
    else
      rm -f "$tmp"
      echo "shtory: merge of $base failed" >&2
    fi
  done
}

# push local files to $1; $2 = the name $1 reports for its own file; $3 = 1 to include it
sync_push() {
  local h=$1 name=$2 self=$3 f base
  local -a push=()
  shopt -s nullglob
  for f in "$HOME"/.shtory/*.jsonl; do
    base=${f##*/}
    if [[ $base == "$name.jsonl" && $self -ne 1 ]]; then
      continue
    fi
    push+=("$f")
  done
  shopt -u nullglob
  if [[ ${#push[@]} -gt 0 ]]; then
    # the remote may not have the dir yet (fresh install, pre-first-log)
    ssh -o ConnectTimeout=10 "$h" 'mkdir -p "$HOME/.shtory"' 2>/dev/null \
      || { echo "shtory: $h: push failed" >&2; return 0; }
    rsync -zaPu -- "${push[@]}" "$h:~/.shtory/" || echo "shtory: $h: push failed" >&2
  fi
}

cmd_sync() {
  local -a hosts=()
  local h f cap='' self=0 name rc
  while [[ $# -gt 0 ]]; do
    case $1 in
      --compact) cap=${2:?}; shift 2 ;;
      --self) self=1; shift ;;
      -*) echo "shtory: unknown sync option: $1" >&2; return 2 ;;
      *) hosts+=("$1"); shift ;;
    esac
  done
  if [[ -n $cap && ! $cap =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --compact: $cap" >&2
    return 2
  fi
  [[ -n $cap ]] && self=1 # --compact implies --self
  if [[ ${#hosts[@]} -eq 0 ]]; then
    local localhost=$SHTORY_HOSTNAME
    shopt -s nullglob
    for f in "$HOME"/.shtory/*.jsonl; do
      h=$(host_of "$f")
      [[ $h == "$localhost" ]] && continue # skip self
      hosts+=("$h")
    done
    shopt -u nullglob
  fi
  if [[ ${#hosts[@]} -eq 0 ]]; then
    echo "shtory: no hosts to sync (no local history files & no args)" >&2
    return 1
  fi

  tmpdir=$(mktemp -d) # global (EXIT trap on signal exit has no locals)
  trap 'rm -rf "${tmpdir-}"' EXIT

  # host->reported-name map in a file (bash 3.2 has no associative arrays)
  namesfile="$tmpdir/names"
  : > "$namesfile"
  name_of_get() { awk -F'\t' -v h="$1" '$1==h {print $2; exit}' "$namesfile"; }

  local -a pulled=() f
  for h in "${hosts[@]}"; do
    if ! ssh_config_host "$h"; then
      echo "shtory: skipping '$h' (not in ~/.ssh/config)" >&2
      continue
    fi
    # name reported by host itself; may differ from ssh alias.
    printf 'shtory: %s: syncing\n' "$h" >&2
    rc=0
    name=$(ssh -o ConnectTimeout=10 "$h" \
      "bash -c 'h=\$(grep ^SHTORY_HOSTNAME= \"\$HOME/.shtory/shtory.env\" 2>/dev/null | tail -n1 | cut -d= -f2-); printf %s \"\${SHTORY_HOSTNAME:-\${h:-\$HOSTNAME}}\"'" 2>/dev/null) || rc=$?
    if (( rc == 255 )); then
      echo "shtory: $h: unreachable (skipped)" >&2
      continue
    fi
    printf '%s\t%s\n' "$h" "${name:-$h}" >> "$namesfile"
    sync_pull "$h" "$tmpdir/$h" && pulled+=("$h")
  done
  if [[ ${#pulled[@]} -eq 0 ]]; then
    return 0
  fi

  sync_merge "$tmpdir"
  if [[ -n $cap ]]; then
    shopt -s nullglob
    for f in "$HOME"/.shtory/*.jsonl; do
      compact_file "$f" "$cap"
    done
    shopt -u nullglob
  fi
  for h in "${pulled[@]}"; do
    rep=$(name_of_get "$h")
    sync_push "$h" "$rep" "$self"
    if [[ $rep != "$h" ]]; then
      echo "shtory: $h: synced (as $rep)"
    else
      echo "shtory: $h: synced"
    fi
  done
}

# bin global rows into a $1-cell-wide grid; sets names/bars
timeline_grid() {
  local W=$1 ramp='_▁▂▃▄▅▆▇█' c idx out max f rest h first last i
  local -a cnt=()
  names=(); bars=()
  for r in "${rows[@]}"; do
    f=${r%% *}; rest=${r#* }
    h=${rest%% *}; rest=${rest#* }
    first=${rest%% *}; rest=${rest#* }; last=${rest%%* }
    # per-bin counts over W-cell axis
    cnt=()
    while IFS= read -r v; do cnt+=("$v"); done < <(awk -v gs="$gstart" -v sp="$span" -v w="$W" '
      { b = (sp > 0) ? int(($1 - gs) * w / sp) : 0
        if (b >= w) b = w - 1
        c[b]++
      } END { for (i = 0; i < w; i++) print c[i] + 0
      }' "$f")
    max=0
    for c in "${cnt[@]}"; do (( c > max )) && max=$c; done
    out=''
    for (( i = 0; i < W; i++ )); do
      c=${cnt[i]}
      if (( c > 0 )); then
        idx=$(( c * 8 / max ))
        out+=${ramp:idx:1}
      else
        out+=' '
      fi
    done
    names+=("$h"); bars+=("$out")
  done
}

timeline_axis() { # $1=W; sets axis from s/e
  axis="$s"
  (( $1 - ${#s} - ${#e} > 0 )) && axis+=$(printf '%*s' "$(( $1 - ${#s} - ${#e} ))" '')
  axis+=$e
}

timeline_lines() { # header + per-host rows into lines[]
  local -a l=()
  local i
  l+=("$(printf '%*s%s  %*s %*s' "$(( namew + 2 ))" '' "$axis" "$wN" cmds "$wD" days)")
  for i in "${!names[@]}"; do
    l+=("$(printf '%*s  %s  %*s %*s' "$namew" "${names[i]}" "${bars[i]}" "$wN" "${ns[i]}" "$wD" "${ds[i]}")")
  done
  lines=("${l[@]}")
}

# render grid to GitHub $SHTORY_GIST_ID (50 char width)
stats_timeline_gist() {
  local W=$(( 50 - namew - wN - wD - 5 ))
  (( W < 20 )) && W=20
  timeline_grid "$W"
  timeline_axis "$W"
  timeline_lines
  local g="${SHTORY_GIST_FILE:-shtory.stats}"
  g=${g##*/}
  [[ -n $g ]] || g=shtory.stats
  local f="$tmpd/$g" err rc=0
  printf '%s\n' "${lines[@]}" > "$f"
  err=$(gh gist edit "$SHTORY_GIST_ID" -f "$g" "$f" 2>&1) || rc=$?
  if (( rc )) && [[ $err == *"no file"* ]]; then
    err=''; rc=0 # gist has no files yet
    err=$(gh gist edit "$SHTORY_GIST_ID" -a "$g" "$f" 2>&1) || rc=$?
  fi
  if (( rc )); then
    echo "shtory: gist edit: $err" >&2
  else
    echo "shtory: gist $SHTORY_GIST_ID updated"
  fi
  return $rc
}

# per-host activity histogram
stats_timeline() {
  local W=40 f h fl first last n size cols i=0 tn=0
  rows=(); ns=(); ds=(); gstart=''; gend=''; namew=0; s=''; e=''
  # per-file jq extract t>0 values; awk binning
  tmpd=$(mktemp -d) # global (EXIT trap on signal exit has no locals)
  trap 'rm -rf "${tmpd-}"' EXIT
  for f in "$@"; do
    h=$(host_of "$f")
    local tfile="$tmpd/$i"
    if ! jq -Rr 'fromjson? | select(. != null) | select(.t > 0) | .t' "$f" > "$tfile"; then
      rm -f "$tfile"; continue
    fi
    i=$(( i + 1 ))
    fl=$(awk 'NR==1{mn=mx=$1} {if($1<mn)mn=$1; if($1>mx)mx=$1} END{if(NR)print mn, mx, NR}' "$tfile")
    [[ -n $fl ]] || continue
    first=${fl%% *}; rest=${fl#* }; last=${rest%% *}; n=${rest##* }
    rows+=("$tfile $h $first $last $n")
    tn=$(( tn + n ))
    if [[ -z $gstart || $first -lt $gstart ]]; then gstart=$first; fi
    if [[ -z $gend || $last -gt $gend ]]; then gend=$last; fi
  done
  if (( ${#rows[@]} == 0 )); then
    echo "shtory: stats: no history with timestamps (only t:0 imports)" >&2
    return 1
  fi
  # combine hosts for TOTAL row; then sort by recent use
  cat -- "$tmpd"/* > "$tmpd/total"
  local -a sorted=()
  while IFS= read -r r; do sorted+=("$r"); done < <(printf '%s\n' "${rows[@]}" | sort -k4,4nr)
  rows=("$tmpd/total TOTAL $gstart $gend $tn" "${sorted[@]}")
  span=$(( gend - gstart ))
  epochdate() { date -u -d "@$1" +%Y-%m-%d 2>/dev/null || date -u -r "$1" +%Y-%m-%d; }
  s=$(epochdate "$gstart")
  e=$(epochdate "$gend")
  # row width = name(namew) + 2sp + axis(W) + 2sp + count(wN) + 1sp + days(wD);
  # wN/wD must be known before W can be clamped to the terminal
  local r rest x
  for r in "${rows[@]}"; do
    f=${r%% *}; rest=${r#* } # drop f
    h=${rest%% *}; rest=${rest#* }
    first=${rest%% *}; rest=${rest#* }; last=${rest%% *}; n=${rest##* }
    (( ${#h} > namew )) && namew=${#h}
    ns+=("$n"); ds+=("$(( (last - first) / 86400 ))")
  done
  wN=4; wD=4
  for x in "${ns[@]}"; do (( ${#x} > wN )) && wN=${#x}; done
  for x in "${ds[@]}"; do (( ${#x} > wD )) && wD=${#x}; done
  # Termux: [[ -t 1 ]] can report false on a real pty; use the proven stty-via-/dev/tty pattern
  if size=$(stty size < /dev/tty 2>/dev/null); then
    cols=${size#* }
    if (( W > cols - namew - wN - wD - 5 )); then
      W=$(( cols - namew - wN - wD - 5 ))
    fi
  fi
  (( W < 20 )) && W=20 # floor: the two 10-char dates alone need W=20
  timeline_grid "$W"
  timeline_axis "$W"
  timeline_lines
  printf '%s\n' "${lines[@]}"
  if [[ -n ${SHTORY_GIST_ID-} ]]; then
    stats_timeline_gist
    return $?
  fi
  return 0
}

cmd_stats() {
  local cmd='' dir='' timeline='' host f
  local -a files=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --timeline) timeline=1; shift ;;
      --cmd) cmd=${2:?}; shift 2 ;;
      --dir) dir=${2:?}; shift 2 ;;
      *) echo "shtory: unknown stats option: $1" >&2; return 2 ;;
    esac
  done
  if [[ -n $cmd && ! $cmd =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --cmd: $cmd" >&2
    return 2
  fi
  if [[ -n $dir && ! $dir =~ ^[0-9]+$ ]]; then
    echo "shtory: bad --dir: $dir" >&2
    return 2
  fi
  if [[ -n $timeline && ( -n $cmd || -n $dir ) ]]; then
    echo "shtory: stats: --timeline cannot be used with --cmd/--dir" >&2
    return 2
  fi
  shopt -s nullglob
  for f in "$HOME"/.shtory/*.jsonl; do
    files+=("$f")
  done
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "shtory: no history files" >&2
    return 1
  fi
  if [[ -n $timeline ]]; then
    stats_timeline "${files[@]}"
    return $?
  fi
  if [[ -z $cmd && -z $dir ]]; then
    for f in "${files[@]}"; do
      host=$(host_of "$f")
      jq -Rc --arg h "$host" '[. , inputs | fromjson? | select(. != null)]
        | {host: $h, commands: length,
           first: (if length then ([.[] | select(.t > 0) | .t] | if length > 0 then (min | todate) else null end) else null end),
           last: (if length then (map(.t) | max | todate) else null end),
           failed: ([.[] | select(.e != 0)] | length)}' "$f" || continue
    done
    return 0
  fi
  if [[ -n $cmd ]]; then
    # shellcheck disable=SC2016 # $n for jq
    jq -Rrc --argjson n "$cmd" '
      [ . , inputs | fromjson? | select(. != null) ]
      | group_by(.c) | map({c: .[0].c, n: length}) | sort_by(-.n, .c) | .[0:$n] | .[]
      | (.n | tostring) + "\t" + .c' "${files[@]}"
  fi
  if [[ -n $dir ]]; then
    # shellcheck disable=SC2016 # $n for jq
    jq -Rrc --argjson n "$dir" --arg home "$HOME" \
      "${TILDE_JQ}"'[ . , inputs | fromjson? | select(. != null) ]
      | group_by(.d) | map({d: .[0].d, n: length}) | sort_by(-.n, .d) | .[0:$n] | .[]
      | (.n | tostring) + "\t" + (.d | tilde)' "${files[@]}"
  fi
}

# dedupe + cap $1 (a history file) to the newest $2 lines
compact_file() {
  local f=$1 n=$2 tmp d
  d=$(mktemp -d)
  tmp=$(mktemp "${f}.XXXXXX") # 0600, same dir as $f so mv is atomic
  if { prog "compact" < "$f"; } | merge_lines "$d" 0 \
    | { (( n == 0 )) && cat > /dev/null || tail -n "$n"; } > "$tmp"; then
    mv -- "$tmp" "$f"
  else
    rm -f "$tmp"
    echo "shtory: compact of ${f##*/} failed" >&2
  fi
  rm -rf "$d"
}

cmd_compact() {
  local n=${1-} f
  if [[ $# -ne 1 || ! $n =~ ^[0-9]+$ ]]; then
    echo "shtory: usage: shtory compact <N>" >&2
    return 2
  fi
  shopt -s nullglob
  for f in "$HOME"/.shtory/*.jsonl; do
    compact_file "$f" "$n"
  done
  shopt -u nullglob
}

# --- dispatch ---------------------------------------------------------------

main() {
  local sub=${1:-help}
  shift || true
  case $sub in
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    search)    cmd_search "$@" ;;
    hostname)  cmd_hostname "$@" ;;
    sync)      cmd_sync "$@" ;;
    stats)     cmd_stats "$@" ;;
    compact)   cmd_compact "$@" ;;
    help|--help) usage ;;
    *) usage >&2; return 2 ;;
  esac
}

# hostname: $SHTORY_HOSTNAME > ~/.shtory/shtory.env > $HOSTNAME
SHTORY_HOSTNAME=${SHTORY_HOSTNAME:-$(grep ^SHTORY_HOSTNAME= "$HOME/.shtory/shtory.env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)}
SHTORY_HOSTNAME=${SHTORY_HOSTNAME:-$HOSTNAME}

main "$@"
